# Direct standalone object builds also need the typed HELAS interface.
# Discover its consumers so classic exports without ALOHA_OBJECT stay valid.
ALOHA_MODULE_USERS = $(patsubst %.f,%.o,$(shell grep -il '^[[:space:]]*use[[:space:]]*aloha_object' *.f))
$(ALOHA_MODULE_USERS): $(LIBDIR)aloha_object.mod

ifneq ("$(wildcard ../../Source/MODEL/flavor_couplings.f)","")
$(LIBDIR)aloha_object.mod: ../../Source/MODEL/model_object.mod
../../Source/MODEL/model_object.mod: ../../Source/MODEL/flavor_couplings.f
	$(MAKE) -C ../../Source/MODEL flavor_couplings.o
	@test -f $@ || $(MAKE) -B -C ../../Source/MODEL flavor_couplings.o
endif

$(LIBDIR)aloha_object.mod: ../../Source/DHELAS/aloha_functions.f
	$(MAKE) -C ../../Source/DHELAS aloha_functions.o
	@test -f ../../Source/DHELAS/aloha_object.mod || $(MAKE) -B -C ../../Source/DHELAS aloha_functions.o
	cp -f ../../Source/DHELAS/aloha_object.mod $@

# Lightweight Born checks and offline reweighting need only some entry points
