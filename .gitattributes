# Files that are only useful for developing MadGraph7 itself, dropped from
# release tarballs (git archive, used by bin/create_release.py).
.github/ export-ignore
.gitattributes export-ignore
.pre-commit-config.yaml export-ignore
.bzrignore export-ignore

# Preserve the frozen report bytes and keep compressed PDF streams out of diffs.
doc/benchmarkfolder/*.pdf binary
