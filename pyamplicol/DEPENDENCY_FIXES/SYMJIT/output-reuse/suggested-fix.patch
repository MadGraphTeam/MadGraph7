+#[cfg(test)]
+mod output_use_tests {
+    use super::*;
+    use crate::CompilerType;
+
+    #[test]
+    fn published_output_reused_by_another_output() -> Result<()> {
+        for opt_level in [0, 2] {
+            let mut config = Config::new(CompilerType::Native, 0)?;
+            config.set_symbolica(true);
+            config.set_opt_level(opt_level);
+            let mut translator = Translator::new(config);
+            translator.set_num_params(2);
+            translator.append_mul(&Slot::Out(0), &[Slot::Param(0), Slot::Param(1)], 2)?;
+            translator.append_add(&Slot::Out(1), &[Slot::Out(0), Slot::Param(0)], 2)?;
+            let app = translator.compile()?;
+
+            for (args, expected) in [([2.0, 3.0], [6.0, 8.0]), ([-1.0, 4.0], [-4.0, -5.0])] {
+                let mut output = [f64::NAN; 2];
+                app.evaluate(&args, &mut output);
+                assert_eq!(output, expected, "optimization level {opt_level}");
+            }
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn overwritten_output_publishes_only_its_last_assignment() -> Result<()> {
+        for reuse_previous in [false, true] {
+            let mut config = Config::new(CompilerType::Native, 0)?;
+            config.set_symbolica(true);
+            config.set_opt_level(2);
+            let mut translator = IndirectTranslator::new(config, "output-overwrite");
+            translator.set_num_params(2);
+            translator.append_mul(&Slot::Out(0), &[Slot::Param(0), Slot::Param(1)], 2)?;
+            translator.append_add(&Slot::Out(1), &[Slot::Out(0), Slot::Param(0)], 2)?;
+            if reuse_previous {
+                translator.append_add(&Slot::Out(0), &[Slot::Out(0), Slot::Param(1)], 2)?;
+            } else {
+                translator.append_mul(&Slot::Out(0), &[Slot::Param(1), Slot::Param(1)], 2)?;
+            }
+            let app = translator.compile()?;
+
+            // The overwritten value gets no publication use, while both final
+            // outputs remain single-use expressions inlined into their stores.
+            assert_eq!(translator.counts[&0], if reuse_previous { 2 } else { 1 });
+            assert_eq!(translator.counts[&1], 1);
+            assert_eq!(translator.counts[&2], 1);
+            assert!(translator.cache.iter().all(Option::is_none));
+
+            for args in [[2.0, 3.0], [-1.0, 4.0]] {
+                let first = if reuse_previous {
+                    args[0] * args[1] + args[1]
+                } else {
+                    args[1] * args[1]
+                };
+                let mut output = [f64::NAN; 2];
+                app.evaluate(&args, &mut output);
+                assert_eq!(output, [first, args[0] * args[1] + args[0]]);
+            }
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn complex_output_reused_by_another_output() -> Result<()> {
+        let mut config = Config::new(CompilerType::Native, 0)?;
+        config.set_symbolica(true);
+        config.set_complex(true);
+        config.set_opt_level(2);
+        let mut translator = Translator::new(config);
+        translator.set_num_params(2);
+        translator.append_mul(&Slot::Out(0), &[Slot::Param(0), Slot::Param(1)], 0)?;
+        translator.append_add(&Slot::Out(1), &[Slot::Out(0), Slot::Param(0)], 0)?;
+        let app = translator.compile()?;
+
+        for args in [
+            [Complex::new(1.0, 2.0), Complex::new(3.0, -1.0)],
+            [Complex::new(-2.0, 1.0), Complex::new(1.0, 4.0)],
+        ] {
+            let mut output = [Complex::new(f64::NAN, f64::NAN); 2];
+            app.evaluate(&args, &mut output);
+            assert_eq!(output, [args[0] * args[1], args[0] * args[1] + args[0]]);
+        }
+        Ok(())
+    }
+}
