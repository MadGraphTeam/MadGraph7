+#[cfg(test)]
+mod real_location_tests {
+    use super::*;
+    use super::super::mir::UniOp;
+
+    #[test]
+    fn physical_real_locations_specialize_only_the_named_inputs() {
+        let mut config = Config::default();
+        config.set_complex(true);
+        let markers = HashSet::from([Loc::Param(2), Loc::Mem(6)]);
+        let mut source = Mir::new(config.clone());
+        source.load_param(Reg::Gen(0), 2);
+        source.load_param(Reg::Gen(1), 4);
+        source.load_mem(Reg::Gen(2), 6);
+        source.load_mem(Reg::Gen(3), 8);
+        let result = Complexifier::new(&markers, config).complexify(&source).unwrap();
+        let instructions: Vec<_> = result.code.iter().collect();
+        assert!(matches!(instructions[0], Instruction::Load { loc: Loc::Param(2), .. }));
+        assert!(matches!(instructions[1], Instruction::LoadComplex { loc: Loc::Param(4), .. }));
+        assert!(matches!(instructions[2], Instruction::Load { loc: Loc::Mem(6), .. }));
+        assert!(matches!(instructions[3], Instruction::LoadComplex { loc: Loc::Mem(8), .. }));
+    }
+
+    #[test]
+    fn overwritten_arena_input_is_complex_even_before_a_backward_branch() {
+        let mut config = Config::default();
+        config.set_complex(true);
+        let markers = HashSet::from([Loc::Mem(2)]);
+        let mut source = Mir::new(config.clone());
+        source.set_label("again");
+        source.load_mem(Reg::Gen(0), 2);
+        source.load_mem(Reg::Gen(1), 4);
+        source.save_mem(Reg::Gen(1), 2);
+        source.load_mem(Reg::Gen(2), 2);
+        source.branch("again");
+        let result = Complexifier::new(&markers, config.clone()).complexify(&source).unwrap();
+        let loads = result.code.iter().filter(|instruction|
+            matches!(instruction, Instruction::LoadComplex { loc: Loc::Mem(2), .. })).count();
+        assert_eq!(loads, 2, "both visits must read the imaginary component");
+        // Generator-level writes also invalidate the declaration immediately.
+        let mut translator = Complexifier::new(&markers, config);
+        translator.load_mem(Reg::Gen(0), 4);
+        translator.save_mem(Reg::Gen(0), 2);
+        assert!(!translator.is_real_loc(Loc::Mem(2)));
+    }
+
