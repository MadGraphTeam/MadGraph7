+//! Real input markers must address the same scalar slots as generated loads.
+use anyhow::Result;
+use std::io::Cursor;
+use symjit::{Application, Compiled, Complex, Composer, Config, PlaneDescriptor, Slot, Storage, Translator};
+
+fn application(direct: bool, arena: bool, opt: u8, fast: bool, compress: bool) -> Result<Application> {
+    let mut config = Config::default();
+    config.set_symbolica(true);
+    config.set_complex(true);
+    config.set_direct(direct);
+    config.set_direct_arena(arena);
+    config.set_direct_arena_identity_output(arena);
+    config.set_opt_level(opt);
+    config.set_fast_complex(fast);
+    config.set_compress(compress);
+    config.set_simd(true);
+    config.set_threads(false);
+    let mut t = Translator::new(config);
+    t.set_num_params(3);
+    // x1 is real, but neighboring x2 is genuinely complex. x0 is unused.
+    t.append_mul(&Slot::Out(0), &[Slot::Param(1), Slot::Param(1)], 2)?;
+    t.append_mul(&Slot::Out(1), &[Slot::Param(2), Slot::Param(2)], 0)?;
+    t.append_mul(&Slot::Out(2), &[Slot::Param(1), Slot::Param(2)], 1)?;
+    t.append_add(&Slot::Out(3), &[Slot::Param(1), Slot::Param(2)], 1)?;
+    t.append_fun(&Slot::Temp(0), "abs", &[Slot::Param(1)], true)?;
+    t.append_mul(&Slot::Out(4), &[Slot::Temp(0), Slot::Param(2)], 0)?;
+    t.compile()
+}
+
+fn check(mut application: Application, context: &str) -> Result<()> {
+    let inputs = [1.0, 2.0, 3.0, 0.0, 5.0, 7.0];
+    let expected = [9.0, 0.0, -24.0, 70.0, 15.0, 21.0, 8.0, 7.0, 15.0, 21.0];
+    let output_count = expected.len() / 2;
+    let states = application.count_states;
+    if states == 0 {
+        application.params[..inputs.len()].copy_from_slice(&inputs);
+    } else {
+        assert_eq!(states, inputs.len());
+    }
+    application.prepare_simd();
+    let app = application.seal()?;
+    assert!(app.compiled.is_some(), "native scalar compiler unavailable: {context}");
+    if cfg!(any(target_arch = "aarch64", target_arch = "x86_64")) {
+        assert!(app.compiled_simd.is_some(), "native SIMD compiler unavailable: {context}");
+    }
+    let lanes = app.compiled_simd.as_ref().map_or(1, |m| m.count_lanes());
+    if states == 0 {
+        // Ordinary translated programs use the public parameter-matrix API,
+        // not the arena-only raw plane kernel accessor.
+        for count in [1, lanes] {
+            let input: Vec<_> = inputs.chunks_exact(2)
+                .map(|z| Complex::new(z[0], z[1])).collect::<Vec<_>>().repeat(count);
+            let mut output = vec![Complex::new(f64::NAN, f64::NAN); output_count * count];
+            app.evaluate_matrix(&input, &mut output, count);
+            for (row, output) in output.chunks_exact(output_count).enumerate() {
+                for (i, z) in output.iter().enumerate() {
+                    assert_eq!([z.re, z.im], [expected[2*i], expected[2*i+1]],
+                               "{context}, count={count}, row={row}, output={i}");
+                }
+            }
+        }
+        return Ok(());
+    }
+    let mut planes = vec![vec![f64::NAN; lanes]; states + expected.len()];
+    for i in 0..states {
+        planes[i].fill(inputs[i]);
+    }
+    let descriptors: Vec<_> = planes.iter_mut().map(|row| unsafe {
+        PlaneDescriptor::from_raw_parts(row.as_mut_ptr(), lanes)
+    }).collect();
+    for (name, kernel, active_lanes) in [
+        ("scalar", app.scalar_plane_kernel(), 1),
+        ("SIMD", app.simd_plane_kernel(), lanes),
+    ] {
+        let kernel = kernel.expect("native arena kernel missing");
+        for row in &mut planes[states..] { row.fill(f64::NAN); }
+        let status = unsafe {
+            kernel(std::ptr::null(), descriptors.as_ptr(), 0, app.params.as_ptr())
+        };
+        assert_eq!(status, 0, "{context}, {name}");
+        for (i, value) in expected.iter().enumerate() {
+            for lane in 0..active_lanes {
+                assert_eq!(planes[states + i][lane], *value,
+                           "{context}, {name}, output component {i}, lane {lane}");
+            }
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn real_input_locations_preserve_complex_neighbors_and_roundtrip() -> Result<()> {
+    // DirectTranslator is parameter-based; IndirectTranslator also supports arenas.
+    for (direct, arena) in [(false, false), (true, false), (false, true)] {
+        for opt in [0, 2, 3] {
+            for fast in [false, true] {
+                for compress in [false, true] {
+                    let app = application(direct, arena, opt, fast, compress)?;
+                    let mut storage = Vec::new();
+                    app.save(&mut storage)?;
+                    let restored = Application::load(&mut Cursor::new(storage), &Config::default())?;
+                    let context = format!("direct={direct}, arena={arena}, O{opt}, fast={fast}, compress={compress}");
+                    check(app, &context)?;
+                    check(restored, &format!("roundtrip, {context}"))?;
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn absolute_value_of_a_real_input_uses_the_real_register() -> Result<()> {
+    let mut config = Config::default();
+    config.set_symbolica(true);
+    config.set_complex(true);
+    config.set_fast_complex(false);
+    config.set_direct(true);
+    config.set_compress(false);
+    let mut t = Translator::new(config);
+    t.set_num_params(2);
+    t.append_fun(&Slot::Out(0), "abs", &[Slot::Param(1)], true)?;
+    let app = t.compile()?.seal()?;
+    let mut output = [Complex::new(f64::NAN, f64::NAN)];
+    app.evaluate_matrix(&[Complex::new(1.0, 2.0), Complex::new(-3.0, 0.0)], &mut output, 1);
+    assert_eq!(output, [Complex::new(3.0, 0.0)]);
+    Ok(())
+}

