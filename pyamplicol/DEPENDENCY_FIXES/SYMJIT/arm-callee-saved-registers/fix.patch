+fn transfer_fp_callee_saved(a: &mut Assembler, mask: u8, base: u32, load: bool) {
+    let registers: Vec<u8> = (8..16).filter(|r| mask & (1 << (r - 8)) != 0).collect();
+    for (pair, registers) in registers.chunks(2).enumerate() {
+        let offset = base + pair as u32 * 16;
+        if let [first, second] = registers {
+            if load {
+                emit(a, arm! {ldp d(*first), d(*second), [sp, #offset]});
+            } else {
+                emit(a, arm! {stp d(*first), d(*second), [sp, #offset]});
+            }
+        } else if load {
+            emit(a, arm! {ldr d(registers[0]), [sp, #offset]});
+        } else {
+            emit(a, arm! {str d(registers[0]), [sp, #offset]});
+        }
+    }
