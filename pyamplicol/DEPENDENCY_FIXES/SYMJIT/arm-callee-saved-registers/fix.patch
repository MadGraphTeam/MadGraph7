+fn callee_saved_fp_mask(mir: &Mir, vector: bool) -> u8 {
+    let mut physical = 0u32;
+    for instruction in mir.code.iter() {
+        let mut logical = Mir::get_dst(&instruction);
+        if let Instruction::LoadComplex { xd, yd, .. } | Instruction::ComplexBi { xd, yd, .. } =
+            instruction
+        {
+            for register in [xd, yd] {
+                if let Reg::Gen(index) = register {
+                    logical |= 1 << index;
+                }
+            }
+        }
+        for (i, register) in FMAP.iter().enumerate() {
+            if logical & (1 << i) != 0 {
+                physical |= 1 << register;
+            }
+        }
+        // Compressed calls use physical argument registers independently of
+        // the allocator. SIMD complex arguments occupy two registers each.
+        let arguments = match instruction {
+            Instruction::LoadArgs {
+                locs,
+                complex,
+                ultra: false,
+            } => Some((locs.len(), complex)),
+            Instruction::SaveArgs {
+                num_args,
+                complex,
+                ultra: true,
+            } => Some((num_args as usize, complex)),
+            _ => None,
+        };
+        if let Some((count, complex)) = arguments {
+            let registers = (count * if vector && complex { 2 } else { 1 }).min(32);
+            for register in 0..registers {
+                physical |= 1 << register;
+            }
+        }
+    }
+    ((physical >> 8) & 0xff) as u8
+}
+
+fn fp_save_size(mask: u8) -> u32 {
+    (mask.count_ones() * 8 + 15) & !15
+}
+
