+        assert_eq!(callee_saved_fp_mask(&mir, false), 0);
+        mir.load_const(Reg::Gen(19), 0); // FMAP[19] = d8.
+        assert_eq!(callee_saved_fp_mask(&mir, false), 1);
+        for (count, complex, vector, expected) in [
+            (8, false, false, 0),
