+    #[test]
+    fn remap_preserves_live_registers_while_normalizing_mixed_scratch_output() {
+        let mut code = MirWriter::new();
+        append_remapped(
+            &mut code,
+            Instruction::SaveComplex {
+                xs: Reg::Temp,
+                ys: Reg::Gen(0),
+                loc: Loc::Mem(0),
+            },
+            0,
+            2,
+            &metadata(DirectDestinationOperation::Accumulate),
+            Some(144),
+        )
+        .unwrap();
+        let instructions = code.iter().collect::<Vec<_>>();
+        assert_eq!(instructions.len(), 5);
+        assert!(matches!(
+            instructions[0],
+            Instruction::SaveComplex {
+                xs: Reg::Gen(0),
+                ys: Reg::Gen(1),
+                loc: Loc::Stack(144),
+            }
+        ));
+        assert!(matches!(
+            instructions[1],
+            Instruction::SaveComplex {
+                xs: Reg::Temp,
+                ys: Reg::Gen(0),
+                loc: Loc::Stack(146),
+            }
+        ));
+        assert!(matches!(
+            instructions[2],
+            Instruction::LoadComplex {
+                xd: Reg::Gen(0),
+                yd: Reg::Gen(1),
+                loc: Loc::Stack(146),
+            }
+        ));
+        assert!(matches!(
+            instructions[3],
+            Instruction::SaveComplex {
+                xs: Reg::Gen(0),
+                ys: Reg::Gen(1),
+                loc: Loc::Mem(6),
+            }
+        ));
+        assert!(matches!(
+            instructions[4],
+            Instruction::LoadComplex {
+                xd: Reg::Gen(0),
+                yd: Reg::Gen(1),
+                loc: Loc::Stack(144),
+            }
+        ));
+    }
