+        expected_generated_calls: u32,
+        table_stack_slots: Option<usize>,
+    ) {
+        run_case_with_source(
+            row_count,
+            fanout,
+            point_start,
+            point_count,
+            expected_generated_calls,
+            table_stack_slots,
+            source_application,
+            table_metadata,
+            oracle_callable,
+        );
+    }
