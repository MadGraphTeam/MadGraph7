+        view.point_start = 0;
+        view.point_count = values[0].len() as u32 + 1;
+        assert_eq!(
+            unsafe { callable.handle().invoke(&view) },
+            DIRECT_STATUS_INVALID_ARGUMENT
+        );
+        view.point_count = 1;
+
+        view.planes = unsafe { planes.as_ptr().cast::<u8>().add(1).cast() };
+        assert_eq!(
+            unsafe { callable.handle().invoke(&view) },
+            DIRECT_STATUS_INVALID_ARGUMENT
+        );
+    }
+}
