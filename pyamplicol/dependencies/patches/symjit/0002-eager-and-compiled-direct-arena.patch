+    fn table_callable_matches_per_row_oracle_for_requested_matrix() {
+        for row_count in [1, 2, 64] {
+            for fanout in [1, 2] {
+                run_case(row_count, fanout, 0, 7, (2 * row_count) as u32);
+            }
+        }
+    }
