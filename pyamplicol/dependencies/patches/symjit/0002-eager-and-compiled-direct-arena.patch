+            vec![1.0; point_count],
+            vec![0.0; point_count],
+            vec![-0.0; point_count],
+            vec![0.0; point_count],
+            vec![f64::from_bits(1); point_count],
+            vec![f64::from_bits(0x8000_0000_0000_0001); point_count],
+        ];
