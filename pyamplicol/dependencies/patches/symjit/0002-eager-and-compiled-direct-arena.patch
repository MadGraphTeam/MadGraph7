+    #[test]
+    fn bitwise_oracle_covers_signed_zero_finite_edges_and_nan_payloads() {
+        const QNAN_A: u64 = 0x7ff8_0000_0000_1234;
+        const QNAN_B: u64 = 0xfff8_0000_0000_5678;
+        let input_re_0 = vec![
+            0.0,
+            -0.0,
