diff --git a/src/symjit/complexify.rs b/src/symjit/complexify.rs
--- a/src/symjit/complexify.rs
+++ b/src/symjit/complexify.rs
@@ -789,10 +789,15 @@ impl Generator for Complexifier {
     }
 
     fn call_funclet(&mut self, label: &str) {
-        self.mir.call(label, 0).unwrap()
+        self.mir.call(label, 0).unwrap();
+        // A helper returns a complete complex value, independently of the
