        "WT": "0",
        "WW": "0",
        "WZ": "0",
        "WH": "0"
      },
      "electroweak_inputs": "alpha_fixed",
      "complex_mass_scheme": false,
      "active_flavours": 5,
      "loop_quark_flavours": 6
    }
  },
