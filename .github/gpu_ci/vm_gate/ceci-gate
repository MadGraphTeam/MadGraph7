#!/usr/bin/python3 -I
"""ceci-gate: the only way for the GitHub runners of the vmadgraph VM to reach the CECI clusters.

Installed root-owned as /usr/local/sbin/ceci-gate and run as the Unix user `ceci`, the only
holder of the CECI ssh key (/var/lib/ceci/.ssh/id_ceci), through one sudoers rule:
    github-runner, ghrunner2 ALL=(ceci) NOPASSWD: /usr/local/sbin/ceci-gate
The CI jobs never see the key. Before touching a cluster, the gate asks GitHub whether the
workflow run it is called for
  - belongs to MadGraphTeam/MadGraph7 (not a fork) and is in progress,
  - comes from the expected workflow file (gpu_lemaitre4_hip.yml, gpu_manneback_cuda.yml,
    gpu_cluster_modules.yml),
  - was started, or re-run, by a GitHub login listed in /etc/ceci-gate/allowed_actors, OR
    runs the code of a branch listed in /etc/ceci-gate/allowed_branches (e.g. main: then any
    commit landing on it is tested, whoever pushed or merged it),
  - has its start_runner (or modules) job running right now on the runner of the calling
    Unix user,
and it only runs the scripts installed next to it in /usr/local/share/ceci-gate, never code
from the checkout. Who may use the clusters is thus decided on this VM, not on GitHub.
Every decision is logged in /var/lib/ceci/gate/gate.log. Setup: .github/gpu_ci/README.md.

    ceci-gate ping CLUSTER
    ceci-gate start-runner CLUSTER RUN_ID RUN_ATTEMPT [--partition P] [--gres G] [--cpus N]
                           [--mem M] [--time HH:MM:SS] [--extra 'SBATCH OPTIONS']
    ceci-gate modules CLUSTER RUN_ID RUN_ATTEMPT [--pattern REGEXP] [--partition P] [--gres G]

Written for the python3 of Rocky Linux 8 (3.6).
"""
import argparse
import json
import os
import pwd
import re
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request

REPO = "MadGraphTeam/MadGraph7"
GATE_USER = "ceci"
SHARE = "/usr/local/share/ceci-gate"          # root-owned copies of the cluster-side scripts
ALLOWED_ACTORS = "/etc/ceci-gate/allowed_actors"      # GitHub logins, one per line
ALLOWED_BRANCHES = "/etc/ceci-gate/allowed_branches"  # optional: branch names, one per line
STATE = "/var/lib/ceci/gate"                  # gate.log and the started/ locks
TOKEN_FILE = "/var/lib/ceci/.github_token"    # optional, against the 60 requests/hour limit
# calling Unix user -> name of its GitHub runner
RUNNERS = {"github-runner": "vmadgraph", "ghrunner2": "vmadgraph-2"}
CLUSTERS = {
    "lemaitre4": {"label": "lemaitre4-apu", "partitions": ["apu"],
                  "workflow": ".github/workflows/gpu_lemaitre4_hip.yml"},
    "manneback": {"label": "manneback-gpu", "partitions": ["gpu"],
                  "workflow": ".github/workflows/gpu_manneback_cuda.yml"},
}
MODULES_WORKFLOW = ".github/workflows/gpu_cluster_modules.yml"
MAX_CPUS = 64
MAX_MEM_GB = 256
MAX_MINUTES = 240
IDLE_MINUTES = 10   # the cluster runner stops after that long without a job
EXTRA_SBATCH = re.compile(r"--(qos|constraint|nodelist|exclude|reservation|account)=[A-Za-z0-9_,.:+\[\]-]{1,100}")
GRES = re.compile(r"gpu(:[A-Za-z0-9_.-]{1,40})?:[1-8]")
PATTERN = re.compile(r"[A-Za-z0-9_.|()*+?^ \[\]-]{0,200}")  # no $ nor `: nothing to expand

CALLER = os.environ.get("SUDO_USER", "?")


def log(message):
    try:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(os.path.join(STATE, "gate.log"), "a") as f:
            f.write("%s caller=%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"), CALLER, message))
    except OSError as e:
        print("ceci-gate: cannot write the log: %s" % e, file=sys.stderr)


def refuse(message):
    log("REFUSED %s :: %s" % (" ".join(sys.argv[1:]), message))
    print("::error::ceci-gate refused: %s" % message)
    sys.exit(2)


def check(condition, message):
    if not condition:
        refuse(message)


def trusted(path):
    """root-owned and not writable by anyone else"""
    st = os.stat(path)
    return st.st_uid == 0 and not st.st_mode & 0o022


def github(path):
    req = urllib.request.Request("https://api.github.com/repos/%s/%s" % (REPO, path), headers={
        "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "ceci-gate"})
    if os.path.isfile(TOKEN_FILE):
        with open(TOKEN_FILE) as f:
            req.add_header("Authorization", "Bearer " + f.read().strip())
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        hint = " (API rate limit? see TOKEN_FILE in ceci-gate)" if e.code in (403, 429) else ""
        refuse("GitHub API %s: HTTP %d %s%s" % (path, e.code, e.reason, hint))
    except (urllib.error.URLError, OSError) as e:
        refuse("GitHub API %s: %s" % (path, e))


def listed(path, required):
    """the entries of a root-owned list file, one per line, # comments"""
    if not required and not os.path.exists(path):
        return set()
    check(os.path.isfile(path) and trusted(path), "%s is missing, or not root-owned, or writable by others" % path)
    with open(path) as f:
        return {line.split("#")[0].strip() for line in f} - {""}


def check_run(run_id, attempt, workflow, events, job_name):
    """Refuse unless run RUN_ID/RUN_ATTEMPT is an allowed run whose job JOB_NAME is the one
    running right now on the runner of the calling Unix user."""
    runner = RUNNERS.get(CALLER)
    check(runner is not None, "Unix user %s is not one of the runner users %s" % (CALLER, sorted(RUNNERS)))
    wf = github("actions/runs/%s/attempts/%s" % (run_id, attempt))
    check((wf.get("repository") or {}).get("full_name") == REPO
          and (wf.get("head_repository") or {}).get("full_name") == REPO,
          "run %s is not a run of %s" % (run_id, REPO))
    check(wf.get("path") == workflow, "run %s is from %s, not %s" % (run_id, wf.get("path"), workflow))
    check(wf.get("event") in events, "run %s was triggered by %s, not %s" % (run_id, wf.get("event"), "/".join(events)))
    check(wf.get("status") == "in_progress", "run %s is %s, not in progress" % (run_id, wf.get("status")))
    actor = ((wf.get("triggering_actor") or wf.get("actor") or {}).get("login") or "?")
    branch = wf.get("head_branch") or "?"
    who = "started by %s on branch %s" % (actor, branch)
    if actor.lower() in {a.lower() for a in listed(ALLOWED_ACTORS, True)}:
        who += " (listed login)"
    elif branch in listed(ALLOWED_BRANCHES, False):  # branch names are case-sensitive
        who += " (listed branch)"
    else:
        refuse("run %s attempt %s was %s: neither the login (%s) nor the branch (%s) is listed on this VM"
               % (run_id, attempt, who, ALLOWED_ACTORS, ALLOWED_BRANCHES))
    # the job can be reported in progress a few seconds after it started
    for wait in (0, 5, 10, 20):
        time.sleep(wait)
        jobs = github("actions/runs/%s/attempts/%s/jobs?per_page=100" % (run_id, attempt)).get("jobs", [])
        if any(j.get("status") == "in_progress" and j.get("runner_name") == runner
               and j.get("name", "").split(" / ")[-1] == job_name for j in jobs):
            return who
    refuse("no %s job of run %s attempt %s is running on runner %s" % (job_name, run_id, attempt, runner))


def lock(name):
    """one start per cluster, run and attempt"""
    started = os.path.join(STATE, "started")
    os.makedirs(started, mode=0o700, exist_ok=True)
    now = time.time()
    for old in os.listdir(started):  # forget the locks older than 30 days
        if now - os.stat(os.path.join(started, old)).st_mtime > 30 * 86400:
            os.rmdir(os.path.join(started, old))
    try:
        os.mkdir(os.path.join(started, name))
    except FileExistsError:
        refuse("%s was already started once" % name)


def share(name):
    path = os.path.join(SHARE, name)
    check(os.path.isfile(path) and trusted(path), "%s is missing, or not root-owned, or writable by others" % path)
    return path


def env():
    me = pwd.getpwnam(GATE_USER)
    # SHELL: ssh runs the ProxyJump command with it
    return {"HOME": me.pw_dir, "USER": GATE_USER, "LOGNAME": GATE_USER, "SHELL": "/bin/bash",
            "PATH": "/usr/bin:/bin", "LANG": "C"}


def execute(cmd, stdin=None):
    sys.stdout.flush()
    return subprocess.call(cmd, stdin=stdin if stdin is not None else subprocess.DEVNULL, env=env())


def remote(cluster, script, args):
    """ssh CLUSTER bash -l -s -- ARGS < SHARE/SCRIPT"""
    with open(share(script), "rb") as f:
        return execute(["ssh", "-o", "BatchMode=yes", cluster,
                    "bash -l -s -- " + " ".join(shlex.quote(a) for a in args)], stdin=f)


def minutes(hhmmss):
    m = re.fullmatch(r"(\d{1,2}):(\d{2}):(\d{2})", hhmmss)
    check(m is not None, "--time %r is not HH:MM:SS" % hhmmss)
    h, mi, s = (int(x) for x in m.groups())
    return h * 60 + mi + (s > 0)


def cmd_ping(a):
    log("ping %s" % a.cluster)
    return execute(["ssh", "-o", "BatchMode=yes", a.cluster, 'echo "connected to $(hostname) as $USER"'])


def cmd_start_runner(a):
    c = CLUSTERS[a.cluster]
    check(a.partition in c["partitions"], "partition %r not allowed on %s %s" % (a.partition, a.cluster, c["partitions"]))
    check(GRES.fullmatch(a.gres) is not None, "--gres %r not allowed" % a.gres)
    check(a.cpus.isdigit() and 1 <= int(a.cpus) <= MAX_CPUS, "--cpus %r not in 1..%d" % (a.cpus, MAX_CPUS))
    m = re.fullmatch(r"(\d{1,4})G", a.mem)
    check(m is not None and 1 <= int(m.group(1)) <= MAX_MEM_GB, "--mem %r not in 1G..%dG" % (a.mem, MAX_MEM_GB))
    check(1 <= minutes(a.time) <= MAX_MINUTES, "--time %s longer than %d minutes" % (a.time, MAX_MINUTES))
    extra = a.extra.split()
    for opt in extra:
        check(EXTRA_SBATCH.fullmatch(opt) is not None, "extra sbatch option %r not allowed" % opt)

    who = check_run(a.run_id, a.attempt, c["workflow"], ("push", "workflow_dispatch"), "start_runner")
    lock("%s-%s-%s" % (a.cluster, a.run_id, a.attempt))
    log("ACCEPTED start-runner %s run=%s attempt=%s %s :: %s %s %s %s %s %s" % (
        a.cluster, a.run_id, a.attempt, who, a.partition, a.gres, a.cpus, a.mem, a.time, " ".join(extra)))
    print("ceci-gate: run %s attempt %s %s, allowed: starting the runner %s on %s"
          % (a.run_id, a.attempt, who, c["label"], a.cluster))

    if execute(["scp", "-q", "-o", "BatchMode=yes", share("runner_batch.sh"), share("job_started_hook.sh"),
            "%s:mg7-gpu-ci/runner-%s/" % (a.cluster, c["label"])]) != 0:
        refuse("no runner in ~/mg7-gpu-ci/runner-%s on %s: install it with .github/gpu_ci/install_runner.sh"
               % (c["label"], a.cluster))
    run_tag = "mg7-run-%s-%s" % (a.run_id, a.attempt)  # RUN_TAG of gpu_runner_ci.yml
    return remote(a.cluster, "remote_start_runner.sh", [
        c["label"], a.run_id, run_tag, str(IDLE_MINUTES),
        "--partition=" + a.partition, "--gres=" + a.gres, "--cpus-per-task=" + a.cpus,
        "--mem=" + a.mem, "--time=" + a.time] + extra)


def cmd_modules(a):
    c = CLUSTERS[a.cluster]
    check(PATTERN.fullmatch(a.pattern) is not None, "--pattern %r has characters outside %s" % (a.pattern, PATTERN.pattern))
    check(a.partition == "" or a.partition in c["partitions"],
          "partition %r not allowed on %s %s" % (a.partition, a.cluster, c["partitions"]))
    check(a.gres == "" or GRES.fullmatch(a.gres) is not None, "--gres %r not allowed" % a.gres)

    who = check_run(a.run_id, a.attempt, MODULES_WORKFLOW, ("workflow_dispatch",), "modules")
    lock("modules-%s-%s-%s" % (a.cluster, a.run_id, a.attempt))
    log("ACCEPTED modules %s run=%s attempt=%s %s :: pattern=%r partition=%r gres=%r" % (
        a.cluster, a.run_id, a.attempt, who, a.pattern, a.partition, a.gres))
    return remote(a.cluster, "remote_modules.sh", [a.pattern, a.partition, a.gres])


def main():
    if pwd.getpwuid(os.getuid()).pw_name != GATE_USER:
        sys.exit("ceci-gate must run as %s: sudo -u %s %s ..." % (GATE_USER, GATE_USER, sys.argv[0]))
    os.umask(0o077)
    p = argparse.ArgumentParser(prog="ceci-gate", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="command")
    sub.required = True
    s = sub.add_parser("ping", help="check the ssh access to a cluster")
    s.add_argument("cluster", choices=sorted(CLUSTERS))
    s.set_defaults(func=cmd_ping)
    for name, func in (("start-runner", cmd_start_runner), ("modules", cmd_modules)):
        s = sub.add_parser(name)
        s.add_argument("cluster", choices=sorted(CLUSTERS))
        s.add_argument("run_id", type=lambda x: x if re.fullmatch(r"\d{1,20}", x) else refuse("bad run id %r" % x))
        s.add_argument("attempt", type=lambda x: x if re.fullmatch(r"\d{1,4}", x) else refuse("bad attempt %r" % x))
        s.set_defaults(func=func)
        if name == "start-runner":
            s.add_argument("--partition", required=True)
            s.add_argument("--gres", default="gpu:1")
            s.add_argument("--cpus", default="8")
            s.add_argument("--mem", default="32G")
            s.add_argument("--time", default="00:20:00")
            s.add_argument("--extra", default="")
        else:
            s.add_argument("--pattern", default=".")
            s.add_argument("--partition", default="")
            s.add_argument("--gres", default="")
    a = p.parse_args()
    sys.exit(a.func(a))


if __name__ == "__main__":
    main()
