+#[test]
+fn borrowed_product_and_actual_zero_one_resets_preserve_state() {
+    for bits in [2, 53, 113, 256, 384] {
+        let mut values: Vec<_> = (0..24).map(|i| number(bits, i)).collect();
+        for exceptional in [f64::INFINITY, f64::NEG_INFINITY, f64::NAN, -0.0, 0.0] {
+            values.push(Complex::new(Float::with_val(bits, exceptional), Float::with_val(bits, -0.0)));
+        }
+        for a in &values {
+            for b in &values {
+                equal_rows(&[borrowed_product(a, b)], &[a.clone() * b]);
+            }
+            // Production resets only to these finite prototype zero/one values.
+            // Rug clone_from for an arbitrary NaN source can retain the old
+            // destination sign; that unrelated failure is retained separately.
+            for b in [Complex::new(Float::new(bits), Float::new(bits)),
+                      Complex::new(Float::with_val(bits, 1), Float::new(bits))] {
+                let mut slot = a.clone();
+                slot.set_from(&b);
+                equal_rows(&[slot], &[b.clone()]);
+            }
+        }
+    }
