+                                }))
+                            })
+                            .collect();
+                        let p: Vec<_> = (0..scalars).map(|i| number(bits, i + lane + 2)).collect();
+                        let request = ExpansionRequest {
+                            id: SampleId { lane, sample: 0 },
+                            partition: &[],
+                            vectors: &v,
+                            parameters: &p,
