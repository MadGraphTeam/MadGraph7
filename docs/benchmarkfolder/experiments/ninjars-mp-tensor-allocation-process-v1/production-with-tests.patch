+#[test]
+fn allocation_tensor_matches_dense_values_precision_and_signed_zero() {
+    for bits in [113, 256, 384] {
+        for rank in 0..=6 {
+            for mu_powers in 0..=2.min(rank / 2) {
+                let prototype = Float::new(bits);
