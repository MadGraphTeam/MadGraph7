+      SUBROUTINE MP_ML5_0_TERMINAL_WL_1_0(A,LCUT_SIZE,B,IN_SIZE
+     $ ,OUT_SIZE,OUT,WL_ENTRY_INEXACT)
+      USE ML5_0_POLYNOMIAL_CONSTANTS
+      USE, INTRINSIC :: IEEE_ARITHMETIC
+      USE, INTRINSIC :: IEEE_EXCEPTIONS
+      INTEGER I,J,K
+      COMPLEX*32 A(MAXLWFSIZE,0:LOOPMAXCOEFS-1,MAXLWFSIZE)
+      COMPLEX*32 B(MAXLWFSIZE,0:VERTEXMAXCOEFS-1,MAXLWFSIZE)
+      COMPLEX*32 OUT(MAXLWFSIZE,0:LOOPMAXCOEFS-1,MAXLWFSIZE)
+      INTEGER LCUT_SIZE,IN_SIZE,OUT_SIZE
+      TYPE(IEEE_ROUND_TYPE) WL_ROUNDING
+      LOGICAL WL_NEAREST
+      LOGICAL WL_ALREADY,WL_HALT,WL_ENTRY_INEXACT
+      LOGICAL WL_SKIP(MAXLWFSIZE,MAXLWFSIZE)
+      INTEGER WL_J,WL_K
+      CALL IEEE_GET_ROUNDING_MODE(WL_ROUNDING)
+      WL_NEAREST=WL_ROUNDING.EQ.IEEE_NEAREST
+      WL_ALREADY=WL_ENTRY_INEXACT
+      WL_HALT=.TRUE.
+      IF(IEEE_SUPPORT_HALTING(IEEE_INEXACT)) CALL
+     $  IEEE_GET_HALTING_MODE(IEEE_INEXACT,WL_HALT)
+      IF(.NOT.WL_NEAREST.OR..NOT.WL_ALREADY.OR.WL_HALT.OR.LCUT_SIZE.GT.
+     $OUT_SIZE.OR.MAXLWFSIZE.GT.16.OR.5.GT.65536.OR.1.GT.65536.OR..NOT.
+     $ALL(WL_BOUNDED(REAL(A(1:IN_SIZE,0:4,1:LCUT_SIZE),KIND=16)))
+     $ .OR..NOT.ALL(WL_BOUNDED(AIMAG(A(1:IN_SIZE,0:4,1:LCUT_SIZE))))
+     $ .OR..NOT.ALL(WL_BOUNDED(REAL(B(1:OUT_SIZE,0:0,1:IN_SIZE)
+     $ ,KIND=16))).OR..NOT.ALL(WL_BOUNDED(AIMAG(B(1:OUT_SIZE,0:0
+     $ ,1:IN_SIZE))))) THEN
+        CALL MP_ML5_0_UPDATE_WL_1_0(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      WL_SKIP=.FALSE.
+      IF(WL_NEAREST) THEN
+        DO WL_K=1,IN_SIZE
+          IF(ALL(WL_IS_FINITE(REAL(A(WL_K,0:4,1:LCUT_SIZE),KIND=16)))
+     $     .AND.ALL(WL_IS_FINITE(AIMAG(A(WL_K,0:4,1:LCUT_SIZE))))) THEN
+            DO WL_J=1,OUT_SIZE
+              IF(ALL(WL_IS_FINITE(REAL(B(WL_J,0:0,WL_K),KIND=16)))
+     $         .AND.ALL(WL_IS_FINITE(AIMAG(B(WL_J,0:0,WL_K)))))
+     $         WL_SKIP(WL_J,WL_K)=ALL(B(WL_J,0:0,WL_K).EQ.0)
+            ENDDO
+          ENDIF
+        ENDDO
+      ENDIF
+      DO I=1,LCUT_SIZE
+        DO K=0,4
+          DO J=1,OUT_SIZE
+            OUT(J,K,I)=CMPLX(0.0E0_16,0.0E0_16,KIND=16)
+          ENDDO
+        ENDDO
+        DO K=1,IN_SIZE
+          DO J=I,I
+            IF(WL_SKIP(J,K)) CYCLE
+            OUT(J,0,I)=OUT(J,0,I)+A(K,0,I)*B(J,0,K)
+            OUT(J,1,I)=OUT(J,1,I)+A(K,1,I)*B(J,0,K)
+            OUT(J,2,I)=OUT(J,2,I)+A(K,2,I)*B(J,0,K)
+            OUT(J,3,I)=OUT(J,3,I)+A(K,3,I)*B(J,0,K)
+            OUT(J,4,I)=OUT(J,4,I)+A(K,4,I)*B(J,0,K)
+          ENDDO
+        ENDDO
+      ENDDO
+      CONTAINS
+      ELEMENTAL LOGICAL FUNCTION WL_IS_FINITE(X)
+      REAL*16, INTENT(IN) :: X
+      INTEGER*8, PARAMETER :: ONE_WORDS(2)=TRANSFER(1.0_16,(/0_8,0_8/))
+      INTEGER, PARAMETER :: HI=MERGE(1,2,ONE_WORDS(1).NE.0_8)
+      WL_IS_FINITE=.FALSE.
+      IF(STORAGE_SIZE(X).NE.128.OR.DIGITS(X).NE.113.OR.RADIX(X)
+     $ .NE.2.OR.MAXEXPONENT(X).NE.16384) RETURN
+      IF(ONE_WORDS(HI).NE.ISHFT(16383_8,48).OR.ONE_WORDS(3-HI).NE.0_8)
+     $ RETURN
+      ASSOCIATE(WORDS=>TRANSFER(X,ONE_WORDS))
