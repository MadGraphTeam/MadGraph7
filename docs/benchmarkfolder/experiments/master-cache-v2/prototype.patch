+fn reset_point(context: &Context, active: Option<bool>, mode: Option<i32>) -> Result<i32> {
+    // The scope lock serializes all operations on this caller-owned context.
+    // Clearing never creates numerical state or starts the Symbolica worker.
+    let mut scope = context.scope.lock().map_err(|_| "point scope poisoned")?;
+    scope.advance()?;
+    if let Some(active) = active { scope.active = active; }
+    if let Some(mode) = mode { scope.enabled = mode != 0; scope.dp_enabled = mode == 1; }
+    if let Some(dp) = context.dp.lock().map_err(|_| "DP context poisoned")?.as_mut() {
+        dp.masters.configure(scope.epoch, scope.dp_enabled);
+    }
+    if let Some(mp) = context.mp.lock().map_err(|_| "MP context poisoned")?.as_ref() {
+        let (reply, receive) = mpsc::sync_channel(1);
+        mp.sender.send(MpMessage::Reset(mp.id, *scope, reply))
+            .map_err(|_| "rescue worker disconnected")?;
+        receive.recv().map_err(|_| "rescue worker disconnected")?;
+    }
+    Ok(SUCCESS)
+}
+
