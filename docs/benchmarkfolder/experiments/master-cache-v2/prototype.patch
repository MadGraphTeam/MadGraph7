+//! Isolated exact-key, bounded master-result cache prototype.
+use std::collections::{hash_map::RandomState, VecDeque};
+use std::hash::{Hash, Hasher};
+use hashbrown::{Equivalent, HashMap};
+use ninjars::{Complex, Float, Laurent, MasterIntegral, MasterProvider, MasterRequest,
+              MasterStatus, Error, Result};
+use ninjars::fast::{C64, FastMaster, FastMasters};
+use ninjars_symbolica::{OneLoopNativeMasters, SymbolicaMasters};
+
+pub const CAPACITY: usize = 4096;
+// GNU native masters can observe rounding, traps, and sticky exception flags.
+unsafe extern "C" {
+    fn ninjars_cache_rounding() -> std::ffi::c_int;
+    fn ninjars_cache_exceptions() -> std::ffi::c_int;
+    fn ninjars_cache_traps() -> std::ffi::c_int;
+    fn ninjars_cache_hardware_controls() -> u64;
+}
+fn rounding_mode() -> (i32, i32, u64) {
+    unsafe { (ninjars_cache_rounding(), ninjars_cache_traps(), ninjars_cache_hardware_controls()) }
+}
+fn exception_flags() -> i32 { unsafe { ninjars_cache_exceptions() } }
+type Environment = (i32, i32, u64);
+fn environment() -> Option<Environment> {
+    let mode = rounding_mode();
+    (mode.0 >= 0 && mode.1 >= 0 && mode.2 != u64::MAX).then_some(mode)
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Stats {
+    pub rows: u64,
+    pub hits: u64,
+    pub misses: u64,
+    pub inserted: u64,
+    pub evicted: u64,
+    pub clears: u64,
+    pub failures: u64,
+    pub entries: u64,
+}
+
+struct Store<K, V> {
+    values: HashMap<K, V, RandomState>,
+    fifo: VecDeque<K>,
+    capacity: usize,
+    epoch: Option<u64>,
+    enabled: bool,
+    last_flags: Option<i32>,
+    stats: Stats,
+}
+impl<K: Clone + Eq + Hash, V> Store<K, V> {
+    fn new(capacity: usize) -> Self {
+        Self { values: HashMap::with_hasher(RandomState::new()), fifo: VecDeque::new(), capacity,
+               epoch: None, enabled: true, last_flags: None, stats: Stats::default() }
+    }
+    fn clear(&mut self) {
+        self.values.clear();
+        self.fifo.clear();
+        self.last_flags = None;
+        self.stats.clears += 1;
+    }
+    fn configure(&mut self, epoch: u64, enabled: bool) {
+        if self.epoch != Some(epoch) || self.enabled != enabled {
+            self.clear();
+        }
+        self.epoch = Some(epoch);
+        self.enabled = enabled;
+    }
+    fn observe_before(&mut self) -> Option<Environment> {
+        // A caller clearing flags makes recomputation observable. Recompute
+        // rather than inventing a replay of flags from a batched evaluation.
+        let flags = exception_flags();
+        if flags < 0 || self.last_flags.is_some_and(|last| last != flags) {
+            #[cfg(test)]
+            eprintln!("cache FENV invalidation: {:?} -> {flags}", self.last_flags);
+            self.clear();
+        }
+        if flags < 0 { None } else { environment() }
+    }
+    fn observe_after(&mut self) {
+        let flags = exception_flags();
+        if flags < 0 { self.clear(); } else { self.last_flags = Some(flags); }
+    }
+    fn insert(&mut self, key: K, value: V) {
+        if !self.enabled || self.capacity == 0 || self.values.contains_key(&key) { return; }
+        if self.values.len() == self.capacity {
+            self.values.remove(&self.fifo.pop_front().unwrap());
+            self.stats.evicted += 1;
+        }
+        self.fifo.push_back(key.clone());
+        self.values.insert(key, value);
+        self.stats.inserted += 1;
+    }
+    fn stats(&self) -> Stats {
+        Stats { entries: self.values.len() as u64, ..self.stats }
+    }
+}
+
+#[derive(Clone, PartialEq, Eq)]
+struct DpKey {
+    rounding: Environment,
+    family: FastMaster,
+    arity: usize,
+    bits: [[u64; 2]; 11],
+}
+impl Hash for DpKey {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.rounding.hash(state);
+        self.family.hash(state);
+        self.bits[..self.arity].hash(state);
+    }
+}
+impl DpKey {
+    #[cfg(test)]
+    fn new(family: FastMaster, args: &[C64]) -> Option<Self> {
+        if exception_flags() < 0 { return None; }
+        Self::with_environment(environment()?, family, args)
+    }
+    fn with_environment(rounding: Environment, family: FastMaster, args: &[C64]) -> Option<Self> {
+        if args.len() > 11 || !args.iter().all(|v| v.is_finite()) { return None; }
+        let mut bits = [[0; 2]; 11];
+        for (dest, value) in bits.iter_mut().zip(args) {
+            *dest = [value.re.to_bits(), value.im.to_bits()];
+        }
+        Some(Self { rounding, family, arity: args.len(), bits })
+    }
+}
+
+pub struct DpMasters {
+    inner: OneLoopNativeMasters,
+    store: Store<DpKey, Vec<[C64; 3]>>,
+}
+impl DpMasters {
+    pub fn new() -> Result<Self> {
+        Ok(Self { inner: OneLoopNativeMasters::new()?, store: Store::new(CAPACITY) })
+    }
+    pub fn configure(&mut self, epoch: u64, enabled: bool) { self.store.configure(epoch, enabled); }
+    pub fn clear(&mut self) { self.store.clear(); }
+    pub fn stats(&self) -> Stats { self.store.stats() }
+}
+impl FastMasters for DpMasters {
+    fn evaluate(&mut self, family: FastMaster, args: &[C64],
+                out: &mut [[C64; 3]], ok: &mut [bool]) -> Result<()> {
+        let rows = ok.len();
+        let arity = family.arity();
+        let width = family.outputs();
+        ninjars::BatchShape { rows, columns: arity }.validate("cached master args", args.len())?;
+        ninjars::BatchShape { rows, columns: width }.validate("cached master outputs", out.len())?;
+        self.store.stats.rows += rows as u64;
+        if !self.store.enabled {
+            self.store.stats.misses += rows as u64;
+            let result = FastMasters::evaluate(&mut self.inner, family, args, out, ok);
+            if result.is_ok() { self.store.stats.failures += ok.iter().filter(|&&v| !v).count() as u64; }
+            return result;
+        }
+        let environment = self.store.observe_before();
+        let mut staged = out.to_vec();
+        let mut staged_ok = ok.to_vec();
+        let mut pending = HashMap::<DpKey, usize, RandomState>::with_hasher(RandomState::new());
+        let mut keys = Vec::new();
+        let mut miss_args = Vec::new();
+        let mut misses = Vec::<Vec<usize>>::new();
+        for row in 0..rows {
+            let point = &args[row*arity..(row+1)*arity];
+            let key = environment.and_then(|env| DpKey::with_environment(env, family, point));
+            if let Some(value) = key.as_ref().and_then(|k| self.store.values.get(k)) {
+                staged[row*width..(row+1)*width].copy_from_slice(value);
+                staged_ok[row] = true;
+                self.store.stats.hits += 1;
+            } else if let Some(&index) = key.as_ref().and_then(|k| pending.get(k)) {
+                misses[index].push(row);
+                self.store.stats.hits += 1;
+            } else {
+                if let Some(key) = &key { pending.insert(key.clone(), misses.len()); }
+                keys.push(key);
+                miss_args.extend_from_slice(point);
+                misses.push(vec![row]);
+                self.store.stats.misses += 1;
+            }
+        }
+        if !misses.is_empty() {
+            let mut values = vec![[C64::ZERO; 3]; misses.len()*width];
+            let mut success = vec![false; misses.len()];
+            let result = FastMasters::evaluate(&mut self.inner, family, &miss_args, &mut values, &mut success);
+            self.store.observe_after();
+            result?;
+            for (index, destinations) in misses.iter().enumerate() {
+                let value = &values[index*width..(index+1)*width];
+                let valid = success[index] && value.iter().flatten().all(|z| z.is_finite());
+                for &row in destinations {
+                    staged_ok[row] = valid;
+                    if valid { staged[row*width..(row+1)*width].copy_from_slice(value); }
+                    else { self.store.stats.failures += 1; }
+                }
+                if valid {
+                    if let Some(key) = keys[index].take() { self.store.insert(key, value.to_vec()); }
+                }
+            }
+        }
+        out.copy_from_slice(&staged);
+        ok.copy_from_slice(&staged_ok);
+        self.store.observe_after();
+        Ok(())
+    }
+}
+
+// Float's own Hash/Eq intentionally ignore precision and signed zero.
+// Both are numerically observable by the provider, so include them explicitly.
+#[derive(Clone, PartialEq, Eq, Hash)]
+struct Component {
+    value: Float,
+    precision: u32,
+    negative: bool,
+}
+impl Component {
+    fn new(value: &Float) -> Self {
+        Self { value: value.clone(), precision: value.prec(), negative: value.is_sign_negative() }
+    }
+}
+#[derive(Clone, PartialEq, Eq)]
+struct MpKey {
+    rounding: Environment,
+    family: MasterIntegral,
+    args: Vec<[Component; 2]>,
+}
+type Z = Complex<Float>;
+impl Hash for MpKey {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.rounding.hash(state);
+        self.family.hash(state);
+        self.args.len().hash(state);
+        for pair in &self.args {
+            pair[0].hash(state);
+            pair[1].hash(state);
+        }
+    }
+}
+impl MpKey {
+    #[cfg(test)]
+    fn new(family: MasterIntegral, args: &[Z]) -> Option<Self> {
+        let mode = environment()?;
+        if exception_flags() < 0 { return None; }
+        args.iter().all(|v| v.re.is_finite() && v.im.is_finite()).then(|| Self {
+            rounding: mode,
+            family,
+            args: args.iter().map(|z| [Component::new(&z.re), Component::new(&z.im)]).collect(),
+        })
+    }
+}
+
+// Queries borrow the provider's original inputs. Hashing/equality preserve the
+// value, tracked precision and zero sign without allocating or cloning Floats.
+// Owned keys are constructed only for genuinely new misses.
+struct MpQuery<'a> {
+    rounding: Environment,
+    family: MasterIntegral,
+    invariants: &'a [Z],
+    masses: &'a [Z],
+    scale: &'a Z,
+}
+impl<'a> MpQuery<'a> {
+    fn new(rounding: Environment, family: MasterIntegral, invariants: &'a [Z],
+           masses: &'a [Z], scale: &'a Z) -> Option<Self> {
+        let query = Self { rounding, family, invariants, masses, scale };
+        let finite = query.args().all(|z| z.re.is_finite() && z.im.is_finite());
+        finite.then_some(query)
+    }
+    fn args(&self) -> impl Iterator<Item = &Z> {
+        self.invariants.iter().chain(self.masses).chain(std::iter::once(self.scale))
+    }
+    fn owned(&self) -> MpKey {
+        MpKey {
+            rounding: self.rounding, family: self.family,
+            args: self.args().map(|z| [Component::new(&z.re), Component::new(&z.im)]).collect(),
+        }
+    }
+}
+impl Hash for MpQuery<'_> {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.rounding.hash(state);
+        self.family.hash(state);
+        (self.invariants.len() + self.masses.len() + 1).hash(state);
+        for z in self.args() {
+            for value in [&z.re, &z.im] {
+                value.hash(state);
+                value.prec().hash(state);
+                value.is_sign_negative().hash(state);
+            }
+        }
+    }
+}
+impl Equivalent<MpKey> for MpQuery<'_> {
+    fn equivalent(&self, key: &MpKey) -> bool {
+        self.rounding == key.rounding && self.family == key.family
+            && self.invariants.len() + self.masses.len() + 1 == key.args.len()
+            && self.args().zip(&key.args).all(|(z, pair)| {
+                [&z.re, &z.im].into_iter().zip(pair).all(|(value, stored)|
+                    value == &stored.value && value.prec() == stored.precision
+                        && value.is_sign_negative() == stored.negative)
+            })
+    }
+}
+pub struct MpMasters {
+    inner: SymbolicaMasters<Float>,
+    // One provider owns immutable working precision/threshold, so its cache
+    // namespace already includes both; no configuration can mutate in place.
+    store: Store<MpKey, Laurent<Z>>,
+    zero: Z,
+}
+impl MpMasters {
+    pub fn new(prototype: Float, threshold: Float) -> Self {
+        Self {
+            inner: SymbolicaMasters::new(prototype.clone()).with_onshell_threshold(Some(threshold)),
+            store: Store::new(CAPACITY),
+            zero: Complex::new(Float::new(prototype.prec()), Float::new(prototype.prec())),
+        }
+    }
+    pub fn configure(&mut self, epoch: u64, enabled: bool) { self.store.configure(epoch, enabled); }
+    pub fn clear(&mut self) { self.store.clear(); }
+    pub fn stats(&self) -> Stats { self.store.stats() }
+}
+impl MasterProvider<Z> for MpMasters {
+    fn evaluate(&mut self, request: MasterRequest<'_, Z>, output: &mut [Laurent<Z>]) -> Result<()> {
+        let mut staged = output.to_vec();
+        let mut statuses = vec![MasterStatus::Success; request.rows()];
+        self.evaluate_batch(request, &mut staged, &mut statuses)?;
+        if statuses.iter().any(|s| *s != MasterStatus::Success) {
+            return Err(Error::Unsupported("cached MP master row failed".into()));
+        }
+        output.clone_from_slice(&staged);
+        Ok(())
+    }
+    fn evaluate_batch(&mut self, request: MasterRequest<'_, Z>, output: &mut [Laurent<Z>],
+                      statuses: &mut [MasterStatus]) -> Result<()> {
+        request.validate(output.len())?;
+        let rows = request.rows();
+        ninjars::BatchShape { rows, columns: 1 }.validate("cached MP statuses", statuses.len())?;
+        self.store.stats.rows += rows as u64;
+        if !self.store.enabled {
+            self.store.stats.misses += rows as u64;
+            let result = self.inner.evaluate_batch(request, output, statuses);
+            if result.is_ok() {
+                self.store.stats.failures += statuses.iter().filter(|&&s| s != MasterStatus::Success).count() as u64;
+            }
+            return result;
+        }
+        let environment = self.store.observe_before();
+        let ni = request.integral.invariant_count();
+        let nm = request.integral.mass_count();
+        let mut staged = output.to_vec();
+        let mut staged_status = statuses.to_vec();
+        let mut pending = HashMap::<MpKey, usize, RandomState>::with_hasher(RandomState::new());
+        let mut keys = Vec::new();
+        let mut inv = Vec::new();
+        let mut masses = Vec::new();
+        let mut scales = Vec::new();
+        let mut misses = Vec::<Vec<usize>>::new();
+        for row in 0..rows {
+            let invariants = &request.invariants[row*ni..(row+1)*ni];
+            let mass = &request.masses_squared[row*nm..(row+1)*nm];
+            let scale = &request.scales_squared[row];
+            let query = environment.and_then(|env| MpQuery::new(env, request.integral, invariants, mass, scale));
+            if let Some(value) = query.as_ref().and_then(|q| self.store.values.get(q)) {
+                staged[row] = value.clone();
+                staged_status[row] = MasterStatus::Success;
+                self.store.stats.hits += 1;
+            } else if let Some(&index) = query.as_ref().and_then(|q| pending.get(q)) {
+                misses[index].push(row);
+                self.store.stats.hits += 1;
+            } else {
+                let key = query.as_ref().map(MpQuery::owned);
+                if let Some(key) = &key { pending.insert(key.clone(), misses.len()); }
+                keys.push(key);
+                inv.extend_from_slice(invariants);
+                masses.extend_from_slice(mass);
+                scales.push(scale.clone());
+                misses.push(vec![row]);
+                self.store.stats.misses += 1;
+            }
+        }
+        if !misses.is_empty() {
+            let mut values = vec![std::array::from_fn(|_| self.zero.clone()); misses.len()];
+            let mut success = vec![MasterStatus::Success; misses.len()];
+            let result = self.inner.evaluate_batch(MasterRequest {
+                integral: request.integral, invariants: &inv,
+                masses_squared: &masses, scales_squared: &scales,
+            }, &mut values, &mut success);
+            self.store.observe_after();
+            result?;
+            for (index, destinations) in misses.iter().enumerate() {
+                let valid = success[index] == MasterStatus::Success
+                    && values[index].iter().all(|z| z.re.is_finite() && z.im.is_finite());
+                let status = if success[index] == MasterStatus::Success && !valid {
+                    MasterStatus::Failed(ninjars::MasterFailure::NonFiniteResult)
+                } else { success[index] };
+                for &row in destinations {
+                    staged_status[row] = status;
+                    if valid { staged[row] = values[index].clone(); }
+                    else { self.store.stats.failures += 1; }
+                }
+                if valid {
+                    if let Some(key) = keys[index].take() { self.store.insert(key, values[index].clone()); }
+                }
+            }
+        }
+        output.clone_from_slice(&staged);
+        statuses.copy_from_slice(&staged_status);
+        self.store.observe_after();
+        Ok(())
+    }
+}
