+    #[test]
+    fn master_cache_borrowed_queries_preserve_hash_and_full_equality() {
+        use std::hash::{BuildHasherDefault, DefaultHasher};
+        #[derive(Default)]
+        struct CollidingHasher;
+        impl Hasher for CollidingHasher {
+            fn finish(&self) -> u64 { 0 }
+            fn write(&mut self, _: &[u8]) {}
+        }
+        let hash = |key: &dyn Fn(&mut DefaultHasher)| {
+            let mut state = DefaultHasher::new();
+            key(&mut state);
+            state.finish()
+        };
+        let z = |x, precision| Complex::new(Float::with_val(precision, x), Float::new(precision));
+        let environment = environment().unwrap();
+        let scale = z(4., 256);
+        let variants = [z(0., 256), z(-0., 256), z(0., 113), z(1., 256)];
+        let mut map = HashMap::<MpKey, usize, BuildHasherDefault<CollidingHasher>>::default();
+        for (i, mass) in variants.iter().enumerate() {
+            let query = MpQuery::new(environment, MasterIntegral::A0, &[], std::slice::from_ref(mass), &scale).unwrap();
+            let owned = query.owned();
+            assert_eq!(hash(&|s| query.hash(s)), hash(&|s| owned.hash(s)));
+            assert!(query.equivalent(&owned));
+            assert!(map.get(&query).is_none());
+            map.insert(owned, i);
+        }
+        for (i, mass) in variants.iter().enumerate() {
+            let query = MpQuery::new(environment, MasterIntegral::A0, &[], std::slice::from_ref(mass), &scale).unwrap();
+            assert_eq!(map.get(&query), Some(&i));
+            let changed_environment = (environment.0, environment.1, environment.2 ^ 1);
+            let changed = MpQuery::new(changed_environment, MasterIntegral::A0, &[], std::slice::from_ref(mass), &scale).unwrap();
+            assert!(map.get(&changed).is_none());
+        }
+        assert_eq!(map.len(), variants.len());
+    }
