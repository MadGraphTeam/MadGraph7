+#define _GNU_SOURCE
+#include <fenv.h>
+#include <stdint.h>
+#if defined(__x86_64__) || defined(__i386__)
+#include <xmmintrin.h>
+#endif
+
+/* Avoid architecture-specific constants in Rust; the supported runtime is GNU. */
+int ninjars_cache_rounding(void) { return fegetround(); }
+int ninjars_cache_exceptions(void) { return fetestexcept(FE_ALL_EXCEPT); }
+int ninjars_cache_traps(void) { return fegetexcept(); }
+uint64_t ninjars_cache_hardware_controls(void) {
+#if defined(__x86_64__) || defined(__i386__)
+    unsigned short x87_control;
+    __asm__ volatile ("fnstcw %0" : "=m"(x87_control));
+    /* MXCSR bits 0..5 are sticky status. Retain FTZ/DAZ, independent SSE
+       rounding/masks and the x87 precision/rounding/exception controls. */
+    return ((uint64_t)x87_control << 32) | (_mm_getcsr() & ~UINT32_C(0x3f));
+#elif defined(__aarch64__)
+    uint64_t fpcr;
+    __asm__ volatile ("mrs %0, fpcr" : "=r"(fpcr));
+    return fpcr;
+#else
+    /* Unobserved hardware controls disable keying without changing results. */
+    return UINT64_MAX;
+#endif
+}
+
+/* Narrow test helpers use the same platform header as production observation. */
+int ninjars_cache_test_upward(void) { return fesetround(FE_UPWARD); }
+int ninjars_cache_test_nearest(void) { return fesetround(FE_TONEAREST); }
+int ninjars_cache_test_restore_rounding(int mode) { return fesetround(mode); }
+int ninjars_cache_test_clear_exceptions(void) { return feclearexcept(FE_ALL_EXCEPT); }
+int ninjars_cache_test_raise_inexact(void) { return feraiseexcept(FE_INEXACT); }
+int ninjars_cache_test_restore_exceptions(int flags) {
+    return feclearexcept(FE_ALL_EXCEPT) || feraiseexcept(flags);
+}
+void ninjars_cache_test_restore_hardware(uint64_t controls) {
+#if defined(__x86_64__) || defined(__i386__)
+    unsigned short x87_control = controls >> 32;
+    _mm_setcsr((uint32_t)controls | (_mm_getcsr() & UINT32_C(0x3f)));
+    __asm__ volatile ("fldcw %0" : : "m"(x87_control));
+#elif defined(__aarch64__)
+    __asm__ volatile ("msr fpcr, %0" : : "r"(controls));
+#endif
+}
+void ninjars_cache_test_toggle_flush(void) {
+    uint64_t controls = ninjars_cache_hardware_controls();
+#if defined(__x86_64__) || defined(__i386__)
+    ninjars_cache_test_restore_hardware(controls ^ UINT64_C(0x8040));
+#elif defined(__aarch64__)
+    ninjars_cache_test_restore_hardware(controls ^ (UINT64_C(1) << 24));
+#endif
+}
