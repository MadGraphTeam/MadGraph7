+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ninjars_point_end(handle: *mut Context) -> i32 {
+    guard(|| reset_point(unsafe { context(handle) }?, Some(false), None))
+}
+#[unsafe(no_mangle)]
