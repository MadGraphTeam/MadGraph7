+    fn master_cache_mp_native_values_precision_and_failures() {
+        let proto = Float::new(256);
+        let threshold = Float::parse("1e-30", Some(256)).unwrap();
+        let mut on = MpMasters::new(proto.clone(), threshold.clone());
+        let mut off = MpMasters::new(proto, threshold);
+        on.configure(1, true);
+        off.configure(1, false);
+        let z = |x: f64| Complex::new(Float::with_val(256, x), Float::new(256));
+        for (point, m0, m1, scale) in [(-4.,0.,4.,4.), (-4.,0.,4.,4.),
+                                     (-4.,4.,0.,4.), (-4.,0.,0.,9.),
+                                     (-9.,0.,4.,9.), (-9.,0.,4.,9.)] {
+            let invariants = [z(point)];
+            let masses = [z(m0), z(m1)];
+            let scales = [z(scale)];
+            let request = MasterRequest { integral: MasterIntegral::B0,
+                invariants: &invariants, masses_squared: &masses, scales_squared: &scales };
+            let mut a = [std::array::from_fn(|_| z(913.))];
+            let mut b = a.clone();
+            let mut sa = [MasterStatus::Success];
+            let mut sb = sa;
+            on.evaluate_batch(request.clone(), &mut a, &mut sa).unwrap();
+            off.evaluate_batch(request.clone(), &mut b, &mut sb).unwrap();
+            assert_eq!(sa, sb);
+            assert_eq!(sa, [MasterStatus::Success]);
+            for (a,b) in a[0].iter().zip(&b[0]) {
+                assert!(Component::new(&a.re) == Component::new(&b.re));
+                assert!(Component::new(&a.im) == Component::new(&b.im));
+            }
+        }
+        assert!(on.stats().hits >= 2);
+        let before = on.stats();
+        let bad_mass = [Complex::new(Float::with_val(256, 4), Float::with_val(256, 1))];
+        let scales = [z(4.)];
+        let bad = MasterRequest { integral: MasterIntegral::A0, invariants: &[],
+            masses_squared: &bad_mass, scales_squared: &scales };
+        for _ in 0..2 {
+            let mut result = [std::array::from_fn(|_| z(913.))];
+            let original = result.clone();
+            let mut status = [MasterStatus::Success];
+            on.evaluate_batch(bad.clone(), &mut result, &mut status).unwrap();
+            assert!(matches!(status[0], MasterStatus::Failed(_)));
+            assert_eq!(result, original);
+        }
+        assert_eq!(on.stats().entries, before.entries);
+        assert_eq!(on.stats().misses, before.misses + 2);
+        on.configure(2, true);
+        assert_eq!(on.stats().entries, 0);
+        let masses = [z(4.)];
+        on.evaluate(MasterRequest { integral: MasterIntegral::A0, invariants: &[],
+            masses_squared: &masses, scales_squared: &scales },
+            &mut [std::array::from_fn(|_| z(0.))]).unwrap();
+        let before = on.stats();
+        let masses = [z(4.), z(9.), z(9.), bad_mass[0].clone()];
+        let scales = [z(4.), z(1.), z(1.), z(4.)];
+        let request = MasterRequest { integral: MasterIntegral::A0, invariants: &[],
+            masses_squared: &masses, scales_squared: &scales };
+        let mut actual: [Laurent<Z>; 4] = std::array::from_fn(|_| std::array::from_fn(|_| z(913.)));
+        let mut expected = actual.clone();
+        let mut status = [MasterStatus::Success; 4];
+        let mut expected_status = status;
+        on.evaluate_batch(request.clone(), &mut actual, &mut status).unwrap();
+        off.evaluate_batch(request.clone(), &mut expected, &mut expected_status).unwrap();
+        assert_eq!(status, expected_status);
+        assert_eq!(actual[..3], expected[..3]);
+        assert!(matches!(status[3], MasterStatus::Failed(_)));
+        assert_eq!(actual[3], std::array::from_fn(|_| z(913.)));
+        assert_eq!(on.stats().hits, before.hits + 2);
+        assert_eq!(on.stats().misses, before.misses + 2);
+        assert_eq!(on.stats().inserted, before.inserted + 1);
+        // Strict evaluation commits no output on a mixed failure, although
+        // independently successful finite cache entries/statistics may advance.
+        let mut strict: [Laurent<Z>; 4] = std::array::from_fn(|_| std::array::from_fn(|_| z(913.)));
+        let original = strict.clone();
+        assert!(on.evaluate(request, &mut strict).is_err());
+        assert_eq!(strict, original);
+    }
