set automatic_html_opening False --no_save
set auto_update 0 --no_save
set nb_core 4 --no_save
set loop_optimized_output True --no_save
set output_dependencies external --no_save
set complex_mass_scheme False --no_save
set ninja /shared/external/madloop_ninjars/madgraph7_madloop_ninjars/.benchmark-work/original/HEPTools/ninja/lib --no_save
set collier /shared/external/madloop_ninjars/madgraph7_madloop_ninjars/.benchmark-work/original/HEPTools/collier --no_save
set ninjars /shared/external/madloop_ninjars/madgraph7_madloop_ninjars/.ninjars-build/abi3-private/HEPTools/ninjars/lib --no_save
import model loop_sm
generate u u~ > z [virt=QCD]
output standalone /shared/external/madloop_ninjars/madgraph7_madloop_ninjars/.ninjars-build/abi3-private/exports/qcd-1
quit
