set group_subprocesses Auto
set ignore_six_quark_processes False
set low_mem_multicore_nlo_generation False
set include_lepton_initiated_processes False
set gauge unitary
set loop_color_flows False
set max_npoint_for_channel 0
set default_unset_couplings 99
set max_t_for_channel 99
set zerowidth_tchannel True
set nlo_mixed_expansion True
set apply_flavor_grouping True
set color_basis auto
set merge_same_topologies True
set merge_quartic_vertices False
set automatic_html_opening False --no_save
set auto_update 0 --no_save
set nb_core 2 --no_save
set loop_optimized_output True --no_save
set output_dependencies external --no_save
set complex_mass_scheme False --no_save
set fortran_compiler /nix/store/5km6kqfhjr16939ak9l1crzsh6x96f68-gfortran-wrapper-15.2.0/bin/gfortran --no_save
set cpp_compiler /nix/store/788mx070y81zjlg5ipcl0cra3afviw9k-gcc-wrapper-15.2.0/bin/c++ --no_save
set ninja /shared/external/madloop_tirust/madgraph7_madloop_tirust/HEPTools/ninja/lib --no_save
set collier /shared/external/madloop_tirust/madgraph7_madloop_tirust/HEPTools/collier --no_save
set ninjars /shared/external/madloop_tirust/madgraph7_madloop_tirust/HEPTools/ninjars/lib --no_save
set tirust /shared/external/madloop_tirust/madgraph7_madloop_tirust/.tirust-build/tirust-oem-signed-prefix-1/HEPTools/tirust/lib --no_save
import model loop_sm
define p = g u c d s u~ c~ d~ s~
define j = g u c d s u~ c~ d~ s~
define l+ = e+ mu+
define l- = e- mu-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~
generate u u~ > z g g g [virt=QCD]
save processes /shared/external/madloop_tirust/madgraph7_madloop_tirust/.tirust-build/zggg-five-backend-timing-1/processes.pkl
output standalone /shared/external/madloop_tirust/madgraph7_madloop_tirust/.tirust-build/zggg-five-backend-timing-1/output
