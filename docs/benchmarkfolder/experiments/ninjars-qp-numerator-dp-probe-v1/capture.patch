+
+      SUBROUTINE NRS_PROBE_BEGIN(MODE,ID,SO,N,RANK,STAGE,SEQ)
+      IMPLICIT NONE
+      INTEGER MODE,ID,SO,N,RANK,STAGE,SEQ,IOS
+      INTEGER PROBE_POINT,PROBE_UNIT,PROBE_SEQUENCE
+      COMMON/NRS_PROBE_POINT/PROBE_POINT
+      COMMON/NRS_PROBE_IO/PROBE_UNIT,PROBE_SEQUENCE
+      SEQ=0
+      IF(PROBE_POINT.NE.44.AND.PROBE_POINT.NE.80) RETURN
+      IF(PROBE_UNIT.EQ.0) THEN
+        OPEN(NEWUNIT=PROBE_UNIT,FILE='tensor-capture.hex',
+     $   STATUS='NEW',ACTION='WRITE',IOSTAT=IOS)
+        IF(IOS.NE.0) STOP 'PROBE OPEN FAILED'
+        WRITE(PROBE_UNIT,'(A,3(1X,Z16.16))') 'LAYOUT',
+     $   TRANSFER(1D0,0_8),TRANSFER(1.0e0_16,[0_8,0_8])
+        WRITE(PROBE_UNIT,'(A,2(1X,Z16.16))') 'COMPLEX64',
+     $   TRANSFER(CMPLX(1D0,2D0,KIND=8),[0_8,0_8])
+        WRITE(PROBE_UNIT,'(A,4(1X,Z16.16))') 'COMPLEX128',
+     $   TRANSFER(CMPLX(1.0e0_16,2.0e0_16,KIND=16),
+     $   [0_8,0_8,0_8,0_8])
+      ENDIF
+      PROBE_SEQUENCE=PROBE_SEQUENCE+1
+      IF(PROBE_SEQUENCE.GT.2500) STOP 'PROBE RECORD LIMIT'
+      SEQ=PROBE_SEQUENCE
+      WRITE(PROBE_UNIT,'(A,8I12)') 'BEGIN',SEQ,PROBE_POINT,
+     $ MODE,ID,SO,N,RANK,STAGE
+      END
+
+      SUBROUTINE NRS_PROBE_CLOSE()
+      IMPLICIT NONE
+      INTEGER PROBE_UNIT,PROBE_SEQUENCE
+      COMMON/NRS_PROBE_IO/PROBE_UNIT,PROBE_SEQUENCE
+      IF(PROBE_UNIT.NE.0) CLOSE(PROBE_UNIT)
+      PROBE_UNIT=0
+      END
+
+      BLOCK DATA NRS_PROBE_INIT
+      IMPLICIT NONE
+      INTEGER PROBE_POINT,PROBE_UNIT,PROBE_SEQUENCE
+      COMMON/NRS_PROBE_POINT/PROBE_POINT
+      COMMON/NRS_PROBE_IO/PROBE_UNIT,PROBE_SEQUENCE
+      DATA PROBE_POINT,PROBE_UNIT,PROBE_SEQUENCE/0,0,0/
+      END
+
+      SUBROUTINE NRS_PROBE_64(SEQ,N,NC,C,S,P,M,U,RES,R1,STATUS)
+      IMPLICIT NONE
+      INTEGER SEQ,N,NC,STATUS,I,J,PROBE_UNIT,PROBE_SEQUENCE
+      COMMON/NRS_PROBE_IO/PROBE_UNIT,PROBE_SEQUENCE
+      COMPLEX*16 C(0:NC-1),M(N),RES(0:2),R1
+      REAL*8 S(N,N),P(0:3,N),U
+      IF(SEQ.EQ.0) RETURN
+      IF(PROBE_UNIT.EQ.0) STOP 'PROBE PAYLOAD WITHOUT BEGIN'
+      WRITE(PROBE_UNIT,'(A,4I12)') 'PAYLOAD',SEQ,64,STATUS,NC
+      DO I=0,NC-1
+        WRITE(PROBE_UNIT,'(A,I6,2(1X,Z16.16))') 'C',I,
+     $   TRANSFER(C(I),[0_8,0_8])
+      ENDDO
+      DO J=1,N
+        DO I=1,N
+          WRITE(PROBE_UNIT,'(A,2I6,1(1X,Z16.16))') 'S',I,J,
+     $     TRANSFER(S(I,J),0_8)
+        ENDDO
+        DO I=0,3
+          WRITE(PROBE_UNIT,'(A,2I6,1(1X,Z16.16))') 'P',I,J,
+     $     TRANSFER(P(I,J),0_8)
+        ENDDO
+        WRITE(PROBE_UNIT,'(A,I6,2(1X,Z16.16))') 'M',J,
+     $   TRANSFER(M(J),[0_8,0_8])
+      ENDDO
+      WRITE(PROBE_UNIT,'(A,1(1X,Z16.16))') 'U',TRANSFER(U,0_8)
+      DO I=0,2
+        WRITE(PROBE_UNIT,'(A,I6,2(1X,Z16.16))') 'R',I,
+     $   TRANSFER(RES(I),[0_8,0_8])
+      ENDDO
+      WRITE(PROBE_UNIT,'(A,2(1X,Z16.16))') 'R1',
+     $ TRANSFER(R1,[0_8,0_8])
+      WRITE(PROBE_UNIT,'(A,I12)') 'END',SEQ
+      END
+
+      SUBROUTINE NRS_PROBE_128(SEQ,N,NC,C,S,P,M,U,RES,R1,STATUS)
+      IMPLICIT NONE
+      INTEGER SEQ,N,NC,STATUS,I,J,PROBE_UNIT,PROBE_SEQUENCE
+      COMMON/NRS_PROBE_IO/PROBE_UNIT,PROBE_SEQUENCE
+      COMPLEX*32 C(0:NC-1),M(N),RES(0:2),R1
+      REAL*16 S(N,N),P(0:3,N),U
+      IF(SEQ.EQ.0) RETURN
+      IF(PROBE_UNIT.EQ.0) STOP 'PROBE PAYLOAD WITHOUT BEGIN'
+      WRITE(PROBE_UNIT,'(A,4I12)') 'PAYLOAD',SEQ,128,STATUS,NC
+      DO I=0,NC-1
+        WRITE(PROBE_UNIT,'(A,I6,4(1X,Z16.16))') 'C',I,
+     $   TRANSFER(C(I),[0_8,0_8,0_8,0_8])
+      ENDDO
+      DO J=1,N
+        DO I=1,N
+          WRITE(PROBE_UNIT,'(A,2I6,2(1X,Z16.16))') 'S',I,J,
+     $     TRANSFER(S(I,J),[0_8,0_8])
+        ENDDO
+        DO I=0,3
+          WRITE(PROBE_UNIT,'(A,2I6,2(1X,Z16.16))') 'P',I,J,
+     $     TRANSFER(P(I,J),[0_8,0_8])
+        ENDDO
+        WRITE(PROBE_UNIT,'(A,I6,4(1X,Z16.16))') 'M',J,
+     $   TRANSFER(M(J),[0_8,0_8,0_8,0_8])
+      ENDDO
+      WRITE(PROBE_UNIT,'(A,2(1X,Z16.16))') 'U',TRANSFER(U,[0_8,0_8])
+      DO I=0,2
+        WRITE(PROBE_UNIT,'(A,I6,4(1X,Z16.16))') 'R',I,
+     $   TRANSFER(RES(I),[0_8,0_8,0_8,0_8])
+      ENDDO
+      WRITE(PROBE_UNIT,'(A,4(1X,Z16.16))') 'R1',
+     $ TRANSFER(R1,[0_8,0_8,0_8,0_8])
+      WRITE(PROBE_UNIT,'(A,I12)') 'END',SEQ
+      END
