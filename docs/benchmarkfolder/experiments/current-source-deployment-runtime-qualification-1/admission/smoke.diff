+def runtime_receipt():
+    """Extend the unchanged build receipt with its two exact ELF interpreter bindings."""
+    require(ADMISSION == WORK/'runtime-admission-2', 'Unexpected derivative location')
+    raw = (ADMISSION/'interpreter-supplement.json').read_bytes()
+    require(hashlib.sha256(raw).hexdigest() == SUPPLEMENT_SHA256, 'Interpreter supplement changed')
+    supplement = json.loads(raw)
+    require(supplement['schema'] == 'tirust-final-deployment-interpreter-supplement-v1',
+            'Wrong interpreter supplement schema')
+    expected = {'proposal/source-index.json': ORIGINAL_SOURCE_INDEX,
+                'build-admitted.json': ORIGINAL_BUILD_RECEIPT,
+                'proposal/smoke.py': ORIGINAL_CONTROLLER}
+    require(supplement['original_bindings'] == expected, 'Original source/build binding changed')
+    for name, checksum in expected.items():
+        require(digest(WORK/name) == checksum, 'Original source/build changed: '+name)
+    receipt = json.loads((WORK/'build-admitted.json').read_text())
+    require(set(supplement['executables']) == {'standalone', 'nlo'}, 'Unexpected executable scope')
+    provider = supplement['additional_runtime_provider']
+    interpreter = Path(provider['path'])
+    require(provider['path'] == provider['resolved'] and str(interpreter.resolve()) == provider['resolved']
+            and interpreter.is_file() and interpreter.stat().st_size == provider['bytes']
+            and digest(interpreter) == provider['sha256'], 'Actual ELF interpreter changed')
+    for label, row in supplement['executables'].items():
+        path = Path(receipt['exports'][label]['process'])/'check'
+        require(str(path) == row['path'] and path.stat().st_size == row['bytes']
+                and digest(path) == row['sha256'] == receipt['exports'][label]['executable_sha256'],
+                'Supplement executable binding changed')
+        require(elf_interpreter(path) == row['pt_interp']
+                and row['pt_interp']['path'] == provider['path'], 'Actual PT_INTERP changed')
+    require(provider['resolved'] not in receipt['runtime_providers'], 'Supplement is not additive')
+    receipt['runtime_providers'][provider['resolved']] = provider['sha256']
+    return receipt
 
 
