+def elf_interpreter(path):
+    """Read the one ELF64 little-endian PT_INTERP without executing the file."""
+    size = path.stat().st_size
+    with path.open('rb') as stream:
+        header = stream.read(64)
+        require(len(header) == 64 and header[:7] == b'\x7fELF\x02\x01\x01',
+                'Expected ELF64 little-endian executable')
+        require(struct.unpack_from('<H', header, 18)[0] == 62, 'Expected x86-64 ELF')
+        phoff = struct.unpack_from('<Q', header, 32)[0]
+        stride, count = struct.unpack_from('<HH', header, 54)
+        require(stride == 56 and 0 < count < 65535 and phoff + stride*count <= size,
+                'Malformed ELF program headers')
+        found = []
+        for i in range(count):
+            stream.seek(phoff + i*stride)
+            program = stream.read(stride)
+            if struct.unpack_from('<I', program)[0] != 3:
+                continue
+            offset = struct.unpack_from('<Q', program, 8)[0]
+            length = struct.unpack_from('<Q', program, 32)[0]
+            require(1 < length <= 4096 and offset + length <= size, 'Malformed PT_INTERP extent')
+            stream.seek(offset)
+            value = stream.read(length)
+            require(value.endswith(b'\0') and value.count(b'\0') == 1, 'Malformed PT_INTERP string')
+            found.append({'path': value[:-1].decode('ascii'), 'offset': offset, 'length': length})
+    require(len(found) == 1, 'Expected exactly one PT_INTERP')
+    return found[0]
+
