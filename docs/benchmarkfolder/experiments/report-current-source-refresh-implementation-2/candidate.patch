+                and set(item) <= {"archive", "archive_sha256", "bytes", "origin", "sha256", "mode"}
+                and type(item["bytes"]) is int and item["bytes"] >= 0 and digest(item["sha256"])
+                and digest(item["archive_sha256"]), "Invalid diagnostic payload identity")
