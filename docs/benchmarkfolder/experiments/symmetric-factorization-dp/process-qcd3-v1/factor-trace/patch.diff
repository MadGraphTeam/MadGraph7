+        DP_FACTOR_COUNTS(3,2)=DP_FACTOR_COUNTS(3,2)+1
+        CALL ML5_0_UPDATE_WL_3_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      CALL IEEE_GET_ROUNDING_MODE(WL_ROUNDING)
+      IF(WL_ROUNDING.NE.IEEE_NEAREST) THEN
+        DP_FACTOR_COUNTS(3,2)=DP_FACTOR_COUNTS(3,2)+1
+        CALL ML5_0_UPDATE_WL_3_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      IF(.NOT.ALL(FACTOR_BOUNDED(REAL(A(1:IN_SIZE,0:34,1:LCUT_SIZE)
+     $ ,KIND=8))).OR..NOT.ALL(FACTOR_BOUNDED(AIMAG(A(1:IN_SIZE,0:34
+     $ ,1:LCUT_SIZE)))).OR..NOT.ALL(FACTOR_BOUNDED(REAL(B(1:OUT_SIZE
+     $ ,0:4,1:IN_SIZE),KIND=8)))
+     $ .OR..NOT.ALL(FACTOR_BOUNDED(AIMAG(B(1:OUT_SIZE,0:4,1:IN_SIZE))))
+     $ ) THEN
+        DP_FACTOR_COUNTS(3,2)=DP_FACTOR_COUNTS(3,2)+1
+        CALL ML5_0_UPDATE_WL_3_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      DO K=1,4
