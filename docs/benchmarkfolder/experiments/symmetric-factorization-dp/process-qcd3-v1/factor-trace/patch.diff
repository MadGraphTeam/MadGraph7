+          CALL ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+          RETURN
+        ENDIF
+      ENDDO
+C     FACTOR_FAST_PATH
+      DP_FACTOR_COUNTS(2,1)=DP_FACTOR_COUNTS(2,1)+1
+      OUT(:,:,:)=(0.0D0,0.0D0)
+      DO J=1,OUT_SIZE
+        M=0
+        DO K=1,IN_SIZE
+          UPDATER_COEF=B(J,M,K)
+          IF(UPDATER_COEF.EQ.(0.0D0,0.0D0)) CYCLE
+          DO I=1,LCUT_SIZE
+            DO L=0,14
+              NEW_POSITION=COMB_COEF_POS(L,M)
+              OUT(J,NEW_POSITION,I)=OUT(J,NEW_POSITION,I)+A(K,L,I)
+     $         *UPDATER_COEF
+            ENDDO
+          ENDDO
+        ENDDO
+      ENDDO
+      U=(0.0D0,0.0D0)
