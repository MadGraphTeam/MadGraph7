+          CALL ML5_0_UPDATE_WL_3_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+          RETURN
+        ENDIF
+      ENDDO
+      DO K=1,4
+        IF(B(2,3,K).NE.CMPLX(AIMAG(B(1,1,K)),-REAL(B(1,1,K),KIND=8)
+     $   ,KIND=8)) THEN
+          DP_FACTOR_COUNTS(3,2)=DP_FACTOR_COUNTS(3,2)+1
+          CALL ML5_0_UPDATE_WL_3_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+          RETURN
+        ENDIF
