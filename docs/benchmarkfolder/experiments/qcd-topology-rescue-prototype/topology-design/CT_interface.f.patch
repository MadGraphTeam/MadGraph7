+C     BEGIN PRIVATE CLASSIFIED APPENDIX
+      SUBROUTINE QK_MP_BUILD_CLASSIFIED(NLOOPLINE,P_LOOP,M2L,S_MAT,GROUP_CONTEXT,MODE_CONTEXT)
+C     
+C     Helper function that compute the loop kinematic matrix with
+C      proper thresholds
+C     NLOOPLINE : Number of loop lines
+C     P_LOOP    : List of external momenta running in the loop, i.e.
+C      q_i in the denominator (l_i+q_i)**2-m_i**2
+C     M2L       : List of complex-valued masses running in the loop.
+C     S_MAT(N,N): Kinematic matrix output.
+C     
+C     ARGUMENTS
+C     
+C QOBS_BEGIN 1
+      USE QCD_KINEMATICS_OBSERVER
+C QOBS_END 1
+      INTEGER NLOOPLINE,GROUP_CONTEXT,MODE_CONTEXT
+      INTEGER QK_PAIR_CLASS
+      LOGICAL SHELL_ELIGIBLE
+      EXTERNAL QK_PAIR_CLASS
+      REAL*16 P_LOOP(NLOOPLINE,0:3)
+      COMPLEX*32 M2L(NLOOPLINE)
+      COMPLEX*32 S_MAT(NLOOPLINE,NLOOPLINE)
+C     
+C     GLOBAL VARIABLES
+C     
+      INCLUDE 'MadLoopParams.inc'
+C     
+C     LOCAL VARIABLES
+C     
+      INTEGER I,J,K
+      COMPLEX*32 DIFFSQ
+      REAL*16 REF_NORMALIZATION
+
+C     ----------
+C     BEGIN CODE
+C     ----------
+
+      DO I=1,NLOOPLINE
+        DO J=1,NLOOPLINE
+
+          IF(I.EQ.J)THEN
+            S_MAT(I,J)=-(M2L(I)+M2L(J))
+C QOBS_BEGIN 2
+      CALL QO_MARK('PAIR_DIAGONAL',I,J,0)
+C QOBS_END 2
+          ELSE
+            DIFFSQ = (CMPLX(P_LOOP(I,0),0.0E0_16,KIND=16)
+     $       -CMPLX(P_LOOP(J,0),0.0E0_16,KIND=16))**2
+            DO K=1,3
+              DIFFSQ = DIFFSQ - (CMPLX(P_LOOP(I,K),0.0E0_16,KIND=16)
+     $         -CMPLX(P_LOOP(J,K),0.0E0_16,KIND=16))**2
+            ENDDO
+C           Default value of the kinematic matrix
+            S_MAT(I,J)=DIFFSQ-M2L(I)-M2L(J)
+            SHELL_ELIGIBLE=QK_PAIR_CLASS(GROUP_CONTEXT,
+     $       MODE_CONTEXT,NLOOPLINE,I,J).NE.0
+C QOBS_BEGIN 3
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('PAIR_DIFFSQ',I,J,
+     $ TRANSFER(DIFFSQ,(/0_8/),4))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('PAIR_S_INITIAL',I,J,
+     $ TRANSFER(S_MAT(I,J),(/0_8/),4))
+C QOBS_END 3
+C           And we now test various thresholds. Normally, at most one
+C            applies.
+            IF(SHELL_ELIGIBLE) THEN
+            IF(ABS(M2L(I)).NE.0.0E0_16)THEN
+              IF(ABS((DIFFSQ-M2L(I))/M2L(I)).LT.OSTHRES)THEN
+                S_MAT(I,J)=-M2L(J)
+C QOBS_BEGIN 4
+      CALL QO_MARK('PAIR_CLAMP',I,J,1)
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('PAIR_S_CLAMPED',I,J,
+     $ TRANSFER(S_MAT(I,J),(/0_8/),4))
+C QOBS_END 4
+              ENDIF
+            ENDIF
+            ENDIF
+            IF(SHELL_ELIGIBLE) THEN
+            IF(ABS(M2L(J)).NE.0.0E0_16)THEN
+              IF(ABS((DIFFSQ-M2L(J))/M2L(J)).LT.OSTHRES)THEN
+                S_MAT(I,J)=-M2L(I)
+C QOBS_BEGIN 5
+      CALL QO_MARK('PAIR_CLAMP',I,J,2)
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('PAIR_S_CLAMPED',I,J,
+     $ TRANSFER(S_MAT(I,J),(/0_8/),4))
+C QOBS_END 5
+              ENDIF
+            ENDIF
+            ENDIF
+C           Choose what seems the most appropriate way to compare
+C           massless onshellness.
+            REF_NORMALIZATION=0.0E0_16
+C           Here, we chose to base the threshold only on the energy
+C            component
+            DO K=0,0
+              REF_NORMALIZATION = REF_NORMALIZATION + ABS(P_LOOP(I,K))
+     $          + ABS(P_LOOP(J,K))
+            ENDDO
+            REF_NORMALIZATION = (REF_NORMALIZATION/2.0E0_16)**2
+C QOBS_BEGIN 7
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('PAIR_E_REFERENCE',I,J,
+     $ TRANSFER(REF_NORMALIZATION,(/0_8/),2))
+C QOBS_END 7
+            IF(SHELL_ELIGIBLE) THEN
+            IF(REF_NORMALIZATION.NE.0.0E0_16)THEN
+              IF(ABS(DIFFSQ/REF_NORMALIZATION).LT.OSTHRES)THEN
+                S_MAT(I,J)=-(M2L(I)+M2L(J))
+C QOBS_BEGIN 6
+      CALL QO_MARK('PAIR_CLAMP',I,J,3)
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('PAIR_S_CLAMPED',I,J,
+     $ TRANSFER(S_MAT(I,J),(/0_8/),4))
+C QOBS_END 6
+              ENDIF
+            ENDIF
+            ENDIF
+          ENDIF
+
+C QOBS_BEGIN 8
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('PAIR_S_FINAL',I,J,
+     $ TRANSFER(S_MAT(I,J),(/0_8/),4))
+C QOBS_END 8
+        ENDDO
+      ENDDO
+
+      END
+
+      SUBROUTINE QK_MP_NINJARS_CLASSIFIED(NLOOPLINE,PL,M2L,RANK,RES,STABLE,GROUP_CONTEXT,MODE_CONTEXT)
+C QOBS_BEGIN 9
+      USE QCD_KINEMATICS_OBSERVER
+C QOBS_END 9
+      USE MNINJARS
+      USE, INTRINSIC :: IEEE_ARITHMETIC, ONLY: IEEE_IS_FINITE
+      USE ML5_0_POLYNOMIAL_CONSTANTS, ONLY: NCOEF_R,COEFTORANK_MAP
+      IMPLICIT NONE
+      INTEGER NLOOPGROUPS,NSQUAREDSO
+      PARAMETER (NLOOPGROUPS=116,NSQUAREDSO=1)
+      INCLUDE 'loop_max_coefs.inc'
+      INTEGER NLOOPLINE,RANK,GROUP_CONTEXT,MODE_CONTEXT
+      REAL*16 PL(0:3,NLOOPLINE)
+      COMPLEX*16 M2L(NLOOPLINE)
+      COMPLEX*16 RES(3)
+      LOGICAL STABLE
+      REAL*8 NORMALIZATION
+      PARAMETER (NORMALIZATION=1.D0/(16.D0*3.14159265358979323846D0**2)
+     $ )
+      REAL*16 P_TMP(0:3,0:NLOOPLINE-1),ABSP_TMP(0:3),REF_P
+      REAL*16 P_NRS(0:3,NLOOPLINE),P_S_MAT(NLOOPLINE,0:3)
+      REAL*16 PDEN_DUMMY(0:3,NLOOPLINE-1),REAL_S_MAT(NLOOPLINE
+     $ ,NLOOPLINE)
+      REAL*16 NRS_SCALE
+      COMPLEX*32 MASSES(NLOOPLINE),S_MAT(NLOOPLINE,NLOOPLINE)
+      COMPLEX*32 TENSORCOEFS(0:LOOPMAXCOEFS-1),NRS_RES(0:2),R1
+      INTEGER I,J,K,CURR_MAXCOEF,NRS_STATUS
+
+      INCLUDE 'coupl.inc'
+      INCLUDE 'MadLoopParams.inc'
+      REAL*8 LSCALE
+      INTEGER CTMODE
+      COMMON/ML5_0_CT/LSCALE,CTMODE
+      INTEGER ID,SQSOINDEX,R
+      COMMON/ML5_0_LOOP/ID,SQSOINDEX,R
+      COMPLEX*32 LOOPCOEFS(0:LOOPMAXCOEFS-1,NSQUAREDSO,NLOOPGROUPS)
+      COMMON/ML5_0_MP_LCOEFS/LOOPCOEFS
+      LOGICAL FPE_IN_DP_REDUCTION,FPE_IN_QP_REDUCTION
+      COMMON/ML5_0_FPE_IN_REDUCTION/FPE_IN_DP_REDUCTION
+     $ ,FPE_IN_QP_REDUCTION
+
+C QOBS_BEGIN 10
+      CALL QO_BEGIN_CALL(8,CTMODE,ID,SQSOINDEX,NLOOPLINE,RANK)
+      CALL QO_MARK('FPE_ENTRY',0,0,MERGE(1,0,FPE_IN_QP_REDUCTION))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('EDGE_INITIAL',0,0,
+     $ TRANSFER(PL,(/0_8/),8*NLOOPLINE))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('MASS2_DP',0,0,
+     $ TRANSFER(M2L,(/0_8/),2*NLOOPLINE))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('NUM_ORIGINAL',0,0,
+     $ TRANSFER(LOOPCOEFS(0:NCOEF_R(RANK)-1,SQSOINDEX,ID),(/0_8/),4*NCOEF_R(RANK)))
+      CALL QO_CAPTURE_CONTEXT()
+C QOBS_END 10
+      STABLE=.FALSE.
+      RES=(0.D0,0.D0)
+      PDEN_DUMMY=0
+      MASSES=CMPLX(M2L,KIND=KI_QNRS)
+C     Preserve MadLoop's loop-direction stability test and mass
+C      ordering.
+      CALL ML5_0_MP_SWITCH_ORDER(CTMODE,NLOOPLINE,PL,PDEN_DUMMY,MASSES)
+C QOBS_BEGIN 11
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('EDGE_ORDERED',0,0,
+     $ TRANSFER(PL,(/0_8/),8*NLOOPLINE))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('MASS2_ORDERED',0,0,
+     $ TRANSFER(MASSES,(/0_8/),4*NLOOPLINE))
+      CALL QO_MARK('ORDER_DONE',0,0,0)
+C QOBS_END 11
+
+C     Match the existing Ninja loop momentum convention, including its
+C     accumulation order and the residual momentum on the first line.
+      P_TMP=0
+      ABSP_TMP=0
+      DO I=0,3
+        DO J=1,NLOOPLINE
+          P_TMP(I,0)=P_TMP(I,0)+PL(I,J)
+          ABSP_TMP(I)=ABSP_TMP(I)+ABS(PL(I,J))
+        ENDDO
+      ENDDO
+      REF_P=MAXVAL(ABSP_TMP)
+C QOBS_BEGIN 12
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('CLOSURE_SUM',0,0,
+     $ TRANSFER(P_TMP(:,0),(/0_8/),8))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('CLOSURE_ABS',0,0,
+     $ TRANSFER(ABSP_TMP,(/0_8/),8))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('CLOSURE_REF',0,0,
+     $ TRANSFER(REF_P,(/0_8/),2))
+      CALL QO_MARK('CLOSURE_CHECK',0,0,0)
+C QOBS_END 12
+      IF (REF_P.GT.1.D-8) THEN
+        DO I=0,3
+          IF (ABS(P_TMP(I,0))/MAX(REF_P*1.D-6,ABSP_TMP(I)).GT.1.D-6)
+     $      THEN
+            FPE_IN_QP_REDUCTION=.TRUE.
+C QOBS_BEGIN 19
+      CALL QO_END_CALL(STABLE,FPE_IN_QP_REDUCTION)
+C QOBS_END 19
+            RETURN
+          ENDIF
+        ENDDO
+      ENDIF
+      DO I=0,3
+        DO J=1,NLOOPLINE-1
+          DO K=1,J
+            P_TMP(I,J)=P_TMP(I,J)+PL(I,K)
+          ENDDO
+        ENDDO
+      ENDDO
+      DO J=1,NLOOPLINE
+        DO I=0,3
+          P_NRS(I,J)=P_TMP(I,J-1)
+          P_S_MAT(J,I)=P_NRS(I,J)
+        ENDDO
+      ENDDO
+C     Use MadLoop's thresholded invariants, including complex on-shell
+C      masses.
+C QOBS_BEGIN 13
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('SHIFTS',0,0,
+     $ TRANSFER(P_NRS,(/0_8/),8*NLOOPLINE))
+C QOBS_END 13
+      CALL QK_MP_BUILD_CLASSIFIED(NLOOPLINE,P_S_MAT,MASSES,S_MAT,GROUP_CONTEXT,MODE_CONTEXT)
+C QOBS_BEGIN 14
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('S_COMPLEX',0,0,
+     $ TRANSFER(S_MAT,(/0_8/),4*NLOOPLINE*NLOOPLINE))
+C QOBS_END 14
+      DO J=1,NLOOPLINE
+        DO I=1,NLOOPLINE
+          REAL_S_MAT(I,J)=REAL(S_MAT(I,J)+MASSES(I)+MASSES(J)
+     $     ,KIND=KI_QNRS)
+        ENDDO
+      ENDDO
+C QOBS_BEGIN 15
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('DISTANCES',0,0,
+     $ TRANSFER(REAL_S_MAT,(/0_8/),2*NLOOPLINE*NLOOPLINE))
+C QOBS_END 15
+      CURR_MAXCOEF=NCOEF_R(RANK)
+      DO I=0,CURR_MAXCOEF-1
+        TENSORCOEFS(I)=LOOPCOEFS(I,SQSOINDEX,ID)
+C       q_loop -> -q_loop in NinjaRS's denominator convention.
+        IF (MOD(COEFTORANK_MAP(I),2).EQ.1) TENSORCOEFS(I)=
+     $   -TENSORCOEFS(I)
+      ENDDO
+      NRS_SCALE=REAL(MU_R**2,KIND=KI_QNRS)
+C QOBS_BEGIN 16
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('NUM_NATIVE',0,0,
+     $ TRANSFER(TENSORCOEFS(0:CURR_MAXCOEF-1),(/0_8/),4*CURR_MAXCOEF))
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('NATIVE_SCALE',0,0,
+     $ TRANSFER(NRS_SCALE,(/0_8/),2))
+      CALL QO_MARK('NATIVE_BEGIN',0,0,0)
+C QOBS_END 16
+      CALL NINJARS_TENSOR_EVALUATE(TENSORCOEFS(0:CURR_MAXCOEF-1)
+     $ ,NLOOPLINE,RANK,REAL_S_MAT,P_NRS,MASSES,NRS_SCALE,NRS_RES,R1
+     $ ,NRS_STATUS,MAX(0,LOOPPOLEMODE))
+C QOBS_BEGIN 17
+      CALL QO_NATIVE_STATUS(NRS_STATUS)
+      IF(NRS_STATUS.NE.NINJARS_SUCCESS) CALL QO_ERROR_NRS()
+      IF(NRS_STATUS.EQ.NINJARS_SUCCESS) THEN
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('NATIVE_CONTRACTED',0,0,
+     $ TRANSFER(NRS_RES,(/0_8/),12))
+      ENDIF
+      CALL QO_MARK('NATIVE_RETURN',0,0,0)
+C QOBS_END 17
+      STABLE=NRS_STATUS.EQ.NINJARS_SUCCESS
+      DO I=0,2
+        STABLE=STABLE.AND.IEEE_IS_FINITE(REAL(NRS_RES(I),KIND=KI_QNRS))
+        STABLE=STABLE.AND.IEEE_IS_FINITE(AIMAG(NRS_RES(I)))
+      ENDDO
+      IF (.NOT.STABLE) THEN
+        FPE_IN_QP_REDUCTION=.TRUE.
+C QOBS_BEGIN 20
+      CALL QO_END_CALL(STABLE,FPE_IN_QP_REDUCTION)
+C QOBS_END 20
+        RETURN
+      ENDIF
+      DO I=0,2
+        RES(I+1)=NORMALIZATION*2.D0*DBLE(NRS_RES(I))
+      ENDDO
+C QOBS_BEGIN 18
+      IF(QO_IS_ACTIVE()) CALL QO_PUT('DP_CONVERTED',0,0,
+     $ TRANSFER(RES,(/0_8/),6))
+C QOBS_END 18
+      DO I=1,3
+        STABLE=STABLE.AND.IEEE_IS_FINITE(DBLE(RES(I)))
+        STABLE=STABLE.AND.IEEE_IS_FINITE(AIMAG(RES(I)))
+      ENDDO
+      IF (.NOT.STABLE) THEN
+        FPE_IN_QP_REDUCTION=.TRUE.
+        RES=(0.D0,0.D0)
+      ENDIF
+C QOBS_BEGIN 21
+      CALL QO_END_CALL(STABLE,FPE_IN_QP_REDUCTION)
+C QOBS_END 21
+      END
