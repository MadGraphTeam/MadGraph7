set automatic_html_opening False --no_save
set auto_update 0 --no_save
set group_subprocesses False --no_save
set loop_optimized_output True --no_save
set output_dependencies external --no_save
set tirust @INSTALL_LIB@ --no_save
set ninja @NINJA_LIB@ --no_save
set collier @COLLIER_LIB@ --no_save
set ninjars @NINJARS_LIB@ --no_save
import model loop_sm
generate u u~ > z [virt=QCD] @101
add process d d~ > z [virt=QCD] @202
output standalone @OUTPUT@ -f
quit
