+//! Private, ignored research harness. The public ABI always stays interpreted.
+use super::*;
+use serde_json::{Value, json};
+use std::io::Write;
+
+fn pack(values: &Value) -> Vec<u8> {
+    values.as_array().unwrap().iter().flat_map(|value| {
+        let text = value.as_str().unwrap().as_bytes();
+        assert!(text.len() <= RECORD);
+        let mut out = [b' '; RECORD];
+        out[..text.len()].copy_from_slice(text);
+        out
+    }).collect()
+}
+fn request(input: &Value) -> MpRequest {
+    let (reply, _) = mpsc::sync_channel(1);
+    MpRequest {
+        context_id: 0,
+        n: input["n"].as_u64().unwrap() as usize,
+        rank: input["rank"].as_u64().unwrap() as usize,
+        coefficients: pack(&input["coefficients"]),
+        s_matrix: pack(&input["s_matrix"]),
+        momenta: pack(&input["momenta"]),
+        masses: pack(&input["masses"]),
+        scale: pack(&input["scale"]),
+        reply,
+    }
+}
+fn input_bytes(r: &MpRequest) -> Vec<Vec<u8>> {
+    [&r.coefficients, &r.s_matrix, &r.momenta, &r.masses, &r.scale]
+        .into_iter().cloned().collect()
+}
+fn represented(value: &Float) -> Value {
+    if !value.is_finite() {
+        return json!({"finite": false, "display": format!("{value}"),
+                      "precision": value.prec(), "negative": value.is_sign_negative()});
+    }
+    let rational = value.to_rational();
+    json!({"finite": true, "numerator": rational.numerator().to_string(),
+           "denominator": rational.denominator().to_string(),
+           "precision": value.prec(), "negative": value.is_sign_negative()})
+}
+fn observe(state: &mut MpState, r: &MpRequest) -> Value {
+    let before = input_bytes(r);
+    let policy = state.study_policy;
+    let precision = state.precision;
+    let result = catch_unwind(AssertUnwindSafe(|| state.evaluate(r)));
+    let mut value = match result {
+        Ok(Ok((status, output))) => {
+            let formatted: Vec<_> = output.chunks_exact(RECORD)
+                .map(|x| std::str::from_utf8(x).unwrap().trim().to_owned()).collect();
+            let raw = if status == SUCCESS {
+                state.entries.get(&(r.n, r.rank)).map(|entry| {
+                    entry.amplitude.results()[0].iter().flat_map(|z| [&z.re, &z.im])
+                        .map(represented).collect::<Vec<_>>()
+                })
+            } else { None };
+            json!({"status": status, "output": formatted, "raw": raw,
+                   "formatted_buffer_bytes": output.len()})
+        }
+        Ok(Err(error)) => json!({"status": ERROR, "error": error, "raw": null, "output": []}),
+        Err(payload) => {
+            let message = payload.downcast_ref::<String>().cloned()
+                .or_else(|| payload.downcast_ref::<&str>().map(|s| (*s).to_owned()))
+                .unwrap_or_else(|| "non-string panic payload".to_owned());
+            // Keep the failure, then replace potentially damaged private state.
+            *state = MpState::with_study_policy(precision, policy).unwrap();
+            json!({"status": ERROR, "panic": true, "panic_message": message, "raw": null, "output": []})
+        }
+    };
+    value["policy"] = json!(format!("{policy:?}"));
+    value["working_bits"] = json!(precision);
+    value["input_unchanged"] = json!(input_bytes(r) == before);
+    value["backends"] = state.entries.get(&(r.n, r.rank)).map_or(Value::Null, |entry| {
+        json!(entry.study_backends.iter().map(|s|
+            json!({"family": format!("{:?}", s.family), "backend": format!("{:?}", s.backend)}))
+            .collect::<Vec<_>>())
+    });
+    value
+}
+fn successful(v: &Value) -> bool {
+    v["status"] == SUCCESS && v["input_unchanged"] == true
+        && v["output"].as_array().is_some_and(|x| x.len() == 8)
+        && v["raw"].as_array().is_some_and(|x| x.len() == 10 && x.iter().all(|r| r["finite"] == true))
+}
+fn emit(stream: &mut impl Write, value: &Value) {
+    serde_json::to_writer(&mut *stream, value).unwrap();
+    stream.write_all(b"\n").unwrap();
+    stream.flush().unwrap();
+}
+fn stream() -> std::io::BufWriter<std::fs::File> {
+    std::io::BufWriter::new(std::fs::OpenOptions::new().write(true).create_new(true)
+        .open(std::env::var("NINJARS_NATIVE_STUDY_OUTPUT").unwrap()).unwrap())
+}
+fn input_records() -> Vec<Value> {
+    std::fs::read_to_string(std::env::var("NINJARS_NATIVE_STUDY_INPUT").unwrap()).unwrap()
+        .lines().map(|line| serde_json::from_str(line).unwrap()).collect()
+}
+fn large_thread(body: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new().stack_size(128 * 1024 * 1024).spawn(body).unwrap().join().unwrap();
+}
+
+#[test]
+#[ignore = "requires explicit MP slot; all three private policies, fixed 1392 requests"]
+fn all_requests_three_policies() {
+    large_thread(|| {
+        let mut output = stream();
+        let records = input_records();
+        assert_eq!(records.len(), 1392);
+        let mut states = StudyKernelPolicy::ALL.map(|p| MpState::with_study_policy(256, p).unwrap());
+        let mut failures = 0usize;
+        let mut baseline_changes = 0usize;
+        let mut native_differences = [0usize; 2];
+        for (index, input) in records.iter().enumerate() {
+            assert_eq!(input["status"], 0);
+            let r = request(input);
+            assert_eq!(r.coefficients.len(), RECORD * 2 * ninjars::fast::tensor_layout::ncoeff(r.rank));
+            let arms = states.iter_mut().map(|s| observe(s, &r)).collect::<Vec<_>>();
+            failures += arms.iter().filter(|v| !successful(v)).count();
+            let baseline_exact = arms[0]["output"] == input["output"] && arms[0]["status"] == input["status"];
+            baseline_changes += usize::from(!baseline_exact);
+            let differences: Vec<_> = arms[1..].iter().map(|a|
+                a["status"] != arms[0]["status"] || a["output"] != arms[0]["output"] || a["raw"] != arms[0]["raw"])
+                .collect();
+            for (counter, different) in native_differences.iter_mut().zip(&differences) { *counter += usize::from(*different); }
+            emit(&mut output, &json!({"kind": "request", "sequence": index, "input": input,
+                "arms": arms, "baseline_exact_historical": baseline_exact,
+                "native_any_value_precision_sign_or_formatted_difference": differences}));
+        }
+        emit(&mut output, &json!({"kind": "summary", "complete": true, "records": records.len(),
+            "arm_fields_each": records.len() * 8, "failed_arms": failures,
+            "baseline_changed_records": baseline_changes, "native_different_records": native_differences,
+            "native_differences_require_offline_review": true, "timing_claim": false}));
+        assert_eq!(failures, 0, "all failed records retained");
+        assert_eq!(baseline_changes, 0, "historical expectations must remain unchanged");
+    });
+}
+
+fn fixture(n: usize, coefficient: &str, masses: &[&str], scale: &str) -> Value {
+    let (s, p) = if n == 1 {
+        (vec!["0"], vec!["0", "0", "0", "0"])
+    } else {
+        (vec!["0", "-4", "-4", "0"], vec!["0", "0", "0", "0", "0", "2", "0", "0"])
+    };
+    json!({"n": n, "rank": 0, "coefficients": [coefficient, "-0"],
+        "s_matrix": s, "momenta": p, "masses": masses, "scale": [scale]})
+}
+fn poles_ok(input: &Value, observed: &Value) -> bool {
+    if !successful(observed) { return false; }
+    let p = 384;
+    let scalar = |s: &str| parse_record_at_precision(&pack(&json!([s])), p).unwrap();
+    let coefficient = scalar(input["coefficients"][0].as_str().unwrap());
+    let expected = if input["n"] == 1 {
+        Complex::new(coefficient.clone() * scalar(input["masses"][0].as_str().unwrap()),
+                     coefficient * scalar(input["masses"][1].as_str().unwrap()))
+    } else { Complex::new(coefficient, Float::new(p)) };
+    let fields = observed["output"].as_array().unwrap();
+    let parse = |index: usize| Float::parse(fields[index].as_str().unwrap(), Some(p)).unwrap();
+    let norm = expected.re.norm() + expected.im.norm();
+    let bound = Float::parse("1e-31", Some(p)).unwrap() * norm;
+    (parse(2) - &expected.re).norm() <= bound && (parse(3) - &expected.im).norm() <= bound
+        && parse(4).is_fully_zero() && parse(5).is_fully_zero()
+}
+
+#[test]
+#[ignore = "requires explicit MP slot; native policy state/analytic controls"]
+fn policies_rebind_fail_recover_and_converge() {
+    large_thread(|| {
+        let mut output = stream();
+        let fixtures = [
+            fixture(1, "1.000000000000000000000000000000788860905", &["4", "-0"], "1"),
+            fixture(2, "1", &["0", "-0", "4", "-0"], "1"),
+            fixture(2, "2", &["4", "-0", "0", "-0"], "9"),
+            fixture(1, "-3", &["9", "-0.125"], "16"),
+            fixture(2, "-3", &["0", "-0", "0", "-0"], "4"),
+        ];
+        let mut failed = 0usize;
+        for bits in [256, 384] {
+            for policy in StudyKernelPolicy::ALL {
+                let mut retained = MpState::with_study_policy(bits, policy).unwrap();
+                for (index, input) in fixtures.iter().enumerate() {
+                    let r = request(input);
+                    let reused = observe(&mut retained, &r);
+                    let fresh = observe(&mut MpState::with_study_policy(bits, policy).unwrap(), &r);
+                    let good = reused == fresh && poles_ok(input, &reused);
+                    failed += usize::from(!good);
+                    emit(&mut output, &json!({"kind": "analytic_rebind", "index": index,
+                        "input": input, "reused": reused, "fresh": fresh, "passed": good}));
+                    // Positive width is rejected before evaluating; then recover exactly.
+                    let mut invalid = input.clone();
+                    invalid["masses"][1] = json!("1");
+                    let bad = observe(&mut retained, &request(&invalid));
+                    let recovered = observe(&mut retained, &r);
+                    let good = bad["status"] == ERROR && bad["output"] == json!([])
+                        && bad["raw"].is_null() && bad["input_unchanged"] == true && recovered == fresh;
+                    failed += usize::from(!good);
+                    emit(&mut output, &json!({"kind": "invalid_then_recover", "input": invalid,
+                        "rejected": bad, "recovered": recovered, "passed": good}));
+                    // Shape error occurs after entry creation; outputs must stay empty.
+                    let mut short = request(input);
+                    short.coefficients.truncate(RECORD);
+                    let bad = observe(&mut retained, &short);
+                    let recovered = observe(&mut retained, &r);
+                    let good = bad["status"] != SUCCESS && bad["output"] == json!([])
+                        && bad["raw"].is_null() && bad["input_unchanged"] == true && recovered == fresh;
+                    failed += usize::from(!good);
+                    emit(&mut output, &json!({"kind": "short_shape_then_recover",
+                        "rejected": bad, "recovered": recovered, "passed": good}));
+                }
+            }
+        }
+        emit(&mut output, &json!({"kind": "summary", "complete": true, "failed_controls": failed}));
+        assert_eq!(failed, 0);
+    });
+}
+
+#[test]
+#[ignore = "requires explicit MP slot; every discrepant request at256/384 plus physical fixture"]
+fn discrepancies_at_256_and_384() {
+    large_thread(|| {
+        let mut output = stream();
+        let records = input_records();
+        assert_eq!(records.len(), 1392);
+        let replay = std::fs::read_to_string(std::env::var("NINJARS_NATIVE_STUDY_REPLAY").unwrap()).unwrap();
+        let mut selected = Vec::new();
+        let mut count = 0usize;
+        let mut complete = false;
+        for line in replay.lines() {
+            let row: Value = serde_json::from_str(line).unwrap();
+            if row["kind"] == "request" {
+                assert_eq!(row["sequence"].as_u64().unwrap() as usize, count);
+                assert_eq!(row["input"], records[count]);
+                if row["native_any_value_precision_sign_or_formatted_difference"].as_array().unwrap()
+                    .iter().any(|x| *x == true) || row["arms"].as_array().unwrap().iter().any(|x| !successful(x)) {
+                    selected.push((json!(count), records[count].clone()));
+                }
+                count += 1;
+            } else if row["kind"] == "summary" {
+                assert_eq!(row["complete"], true);
+                complete = true;
+            } else { panic!("unknown replay record"); }
+        }
+        assert_eq!(count, 1392);
+        assert!(complete);
+        let fixture: Value = serde_json::from_str(include_str!("../tests/data/convergence.json")).unwrap();
+        let mut input = fixture["input"].clone();
+        input["masses"] = input["masses_squared"].clone();
+        input["scale"] = input["scale_squared"].clone();
+        selected.push((json!("physical_complex_mass_pentagon"), input));
+        let mut failures = 0usize;
+        for bits in [256, 384] {
+            let mut states = StudyKernelPolicy::ALL.map(|p| MpState::with_study_policy(bits, p).unwrap());
+            for (sequence, input) in &selected {
+                let r = request(input);
+                let arms = states.iter_mut().map(|s| observe(s, &r)).collect::<Vec<_>>();
+                failures += arms.iter().filter(|x| !successful(x)).count();
+                emit(&mut output, &json!({"kind": "convergence", "sequence": sequence,
+                    "working_bits": bits, "input": input, "arms": arms}));
+            }
+        }
+        emit(&mut output, &json!({"kind": "summary", "complete": true,
+            "requests_per_precision": selected.len(), "failed_arms": failures,
+            "convergence_value_sign_precision_assessment": "offline; raw fields retained", "timing_claim": false}));
+        assert_eq!(failures, 0);
+    });
+}
