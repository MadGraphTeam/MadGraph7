set automatic_html_opening False
set auto_update 0
set nb_core 4
set loop_optimized_output True
set output_dependencies external
set complex_mass_scheme False
set ninja /shared/external/madloop_tirust/madgraph7_madloop_tirust/HEPTools/ninja/lib
set collier /shared/external/madloop_tirust/madgraph7_madloop_tirust/HEPTools/collier
set ninjars /shared/external/madloop_tirust/madgraph7_madloop_tirust/HEPTools/ninjars/lib
set tirust /shared/external/madloop_tirust/madgraph7_madloop_tirust/HEPTools/tirust/lib
import model loop_sm
generate u u~ > z g g [virt=QCD]
output standalone /shared/external/madloop_tirust/madgraph7_madloop_tirust/.tirust-build/dp-terminal-production/outputs/candidate/qcd_n3_uux_zgg
quit
