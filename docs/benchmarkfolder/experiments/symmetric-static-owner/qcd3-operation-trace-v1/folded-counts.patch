+      SUBROUTINE MP_ML5_0_UPDATE_WL_2_1_SHARED_VVV1L2P0_1(A,LCUT_SIZE
+     $ ,B,IN_SIZE,OUT_SIZE,OUT)
+      USE ML5_0_POLYNOMIAL_CONSTANTS
+      USE, INTRINSIC :: IEEE_ARITHMETIC
