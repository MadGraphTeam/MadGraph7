+      SHARE_COUNTS(1,5)=SHARE_COUNTS(1,5)+1
+      OUT(:,:,:)=CMPLX(0.0E0_16,0.0E0_16,KIND=16)
+      DO J=1,OUT_SIZE
+        DO M=0,4
+          DO K=1,IN_SIZE
