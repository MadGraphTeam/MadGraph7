+      SUBROUTINE MP_ML5_0_TERMINAL_WL_2_1_SHARED_FFV1L3_2(A,LCUT_SIZE
+     $ ,B,IN_SIZE,OUT_SIZE,OUT,WL_ENTRY_INEXACT)
+      USE ML5_0_POLYNOMIAL_CONSTANTS
