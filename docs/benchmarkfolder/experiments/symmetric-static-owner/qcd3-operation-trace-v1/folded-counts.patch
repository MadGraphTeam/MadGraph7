+        RETURN
+      ENDIF
+
+      CALL IEEE_GET_ROUNDING_MODE(WL_ROUNDING)
+      WL_NEAREST=WL_ROUNDING.EQ.IEEE_NEAREST
+      IF(.NOT.WL_NEAREST) THEN
+        SHARE_COUNTS(2,5)=SHARE_COUNTS(2,5)+1
+        CALL MP_ML5_0_UPDATE_WL_2_1_DENSE(A,LCUT_SIZE,B,IN_SIZE
+     $   ,OUT_SIZE,OUT)
+        RETURN
