+        SHARE_COUNTS(2,5)=SHARE_COUNTS(2,5)+1
+        CALL MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      IF(ANY(TRANSFER(B(1,1,2),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(4,4
+     $ ,2),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,5)=SHARE_COUNTS(2,5)+1
+        CALL MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      IF(ANY(TRANSFER(B(1,1,3),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(2,2
+     $ ,3),(/0_8,0_8,0_8,0_8/)))) THEN
