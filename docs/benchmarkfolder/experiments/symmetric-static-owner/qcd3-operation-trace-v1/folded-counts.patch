+        CALL MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      IF(ANY(TRANSFER(B(3,1,3),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(4,2
+     $ ,3),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,1)=SHARE_COUNTS(2,1)+1
+        CALL MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+C     STATIC_OWNER_FAST_PATH
+      SHARE_COUNTS(1,1)=SHARE_COUNTS(1,1)+1
+      OUT(:,:,:)=CMPLX(0.0E0_16,0.0E0_16,KIND=16)
+      DO J=1,OUT_SIZE
+        DO M=0,4
+          DO K=1,IN_SIZE
+            OP_COUNTS(7,1)=OP_COUNTS(7,1)+1
+            UPDATER_COEF = B(J,M,K)
+            GROUP_ID=GROUP_MAP(J,M,K)
+            IF (UPDATER_COEF.EQ.CMPLX(0.0E0_16,0.0E0_16,KIND=16)) THEN
+              OP_COUNTS(6,1)=OP_COUNTS(6,1)+15*LCUT_SIZE
+              CYCLE
+            ENDIF
+            WL_SKIP_ZERO=.TRUE.
+            IF(GROUP_ID.EQ.0) THEN
+              DO I=1,LCUT_SIZE
+                DO L=0,14
+                  IF(WL_SKIP_ZERO) THEN
+                    IF(WL_AZERO(K,L,I)) THEN
+                      OP_COUNTS(5,1)=OP_COUNTS(5,1)+1
+                      CYCLE
+                    ENDIF
+                  ENDIF
+                  OP_COUNTS(1,1)=OP_COUNTS(1,1)+1
+                  IF(REAL(UPDATER_COEF,KIND=16).EQ.0) THEN
+                    OP_COUNTS(8,1)=OP_COUNTS(8,1)+1
+                  ELSEIF(AIMAG(UPDATER_COEF).EQ.0) THEN
+                    OP_COUNTS(9,1)=OP_COUNTS(9,1)+1
+                  ELSE
+                    OP_COUNTS(10,1)=OP_COUNTS(10,1)+1
+                  ENDIF
+                  NEW_POSITION = COMB_COEF_POS(L,M)
+                  OP_COUNTS(2,1)=OP_COUNTS(2,1)+1
+                  OUT(J,NEW_POSITION,I)=OUT(J,NEW_POSITION,I) + A(K,L
+     $             ,I)*UPDATER_COEF
+                ENDDO
+              ENDDO
+            ELSEIF(GROUP_ID.GT.0) THEN
+              DO I=1,LCUT_SIZE
+                DO L=0,14
+                  IF(WL_SKIP_ZERO) THEN
+                    IF(WL_AZERO(K,L,I)) THEN
+                      OP_COUNTS(5,1)=OP_COUNTS(5,1)+1
+                      CYCLE
+                    ENDIF
+                  ENDIF
+                  OP_COUNTS(1,1)=OP_COUNTS(1,1)+1
+                  IF(REAL(UPDATER_COEF,KIND=16).EQ.0) THEN
+                    OP_COUNTS(8,1)=OP_COUNTS(8,1)+1
+                  ELSEIF(AIMAG(UPDATER_COEF).EQ.0) THEN
+                    OP_COUNTS(9,1)=OP_COUNTS(9,1)+1
+                  ELSE
+                    OP_COUNTS(10,1)=OP_COUNTS(10,1)+1
+                  ENDIF
+                  NEW_POSITION = COMB_COEF_POS(L,M)
+                  OP_COUNTS(3,1)=OP_COUNTS(3,1)+1
+                  PRODUCT_CACHE(GROUP_ID,L,I)=A(K,L,I)*UPDATER_COEF
+                  OUT(J,NEW_POSITION,I)=OUT(J,NEW_POSITION,I) +
+     $              PRODUCT_CACHE(GROUP_ID,L,I)
+                ENDDO
+              ENDDO
+            ELSE
+              DO I=1,LCUT_SIZE
+                DO L=0,14
+                  IF(WL_SKIP_ZERO) THEN
+                    IF(WL_AZERO(K,L,I)) THEN
+                      OP_COUNTS(5,1)=OP_COUNTS(5,1)+1
+                      CYCLE
+                    ENDIF
+                  ENDIF
+                  OP_COUNTS(1,1)=OP_COUNTS(1,1)+1
+                  IF(REAL(UPDATER_COEF,KIND=16).EQ.0) THEN
+                    OP_COUNTS(8,1)=OP_COUNTS(8,1)+1
+                  ELSEIF(AIMAG(UPDATER_COEF).EQ.0) THEN
+                    OP_COUNTS(9,1)=OP_COUNTS(9,1)+1
+                  ELSE
+                    OP_COUNTS(10,1)=OP_COUNTS(10,1)+1
+                  ENDIF
+                  NEW_POSITION = COMB_COEF_POS(L,M)
+                  OP_COUNTS(4,1)=OP_COUNTS(4,1)+1
+                  OUT(J,NEW_POSITION,I)=OUT(J,NEW_POSITION,I) +
+     $              PRODUCT_CACHE(-GROUP_ID,L,I)
+                ENDDO
+              ENDDO
+            ENDIF
+          ENDDO
+        ENDDO
+      ENDDO
+
+      CONTAINS
+      ELEMENTAL LOGICAL FUNCTION WL_IS_FINITE(X)
+      REAL*16, INTENT(IN) :: X
+      INTEGER*8, PARAMETER :: ONE_WORDS(2)=TRANSFER(1.0_16,(/0_8,0_8/))
+      INTEGER, PARAMETER :: HI=MERGE(1,2,ONE_WORDS(1).NE.0_8)
+      WL_IS_FINITE=.FALSE.
+      IF(STORAGE_SIZE(X).NE.128.OR.DIGITS(X).NE.113.OR.RADIX(X)
+     $ .NE.2.OR.MAXEXPONENT(X).NE.16384) RETURN
+      IF(ONE_WORDS(HI).NE.ISHFT(16383_8,48).OR.ONE_WORDS(3-HI).NE.0_8)
+     $  RETURN
+      ASSOCIATE(WORDS=>TRANSFER(X,ONE_WORDS))
+      WL_IS_FINITE=IBITS(WORDS(HI),48,15).NE.32767_8
+      END ASSOCIATE
+      END FUNCTION
+
+      ELEMENTAL LOGICAL FUNCTION GATHER_BOUNDED(X)
+      REAL*16, INTENT(IN) :: X
+      INTEGER*8, PARAMETER :: ONE(2)=TRANSFER(1.0_16,(/0_8,0_8/))
+      INTEGER, PARAMETER :: HI=MERGE(1,2,ONE(1).NE.0_8)
+      GATHER_BOUNDED=.FALSE.
+      IF(STORAGE_SIZE(X).NE.128.OR.DIGITS(X).NE.113.OR.RADIX(X)
+     $ .NE.2.OR.MAXEXPONENT(X).NE.16384) RETURN
+      IF(ONE(HI).NE.ISHFT(16383_8,48).OR.ONE(3-HI).NE.0_8) RETURN
+      ASSOCIATE(WORDS=>TRANSFER(X,ONE))
+      GATHER_BOUNDED=IBITS(WORDS(HI),48,15)
+     $ .GE.15383_8.AND.IBITS(WORDS(HI),48,15).LE.17383_8
+      IF(IBCLR(WORDS(HI),63).EQ.0_8.AND.WORDS(3-HI).EQ.0_8)
+     $  GATHER_BOUNDED=.TRUE.
+      END ASSOCIATE
+      END FUNCTION
+
+      END
