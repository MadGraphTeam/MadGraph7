+      IF(ANY(TRANSFER(B(4,1,4),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(4,4
+     $ ,4),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,12)=SHARE_COUNTS(2,12)+1
