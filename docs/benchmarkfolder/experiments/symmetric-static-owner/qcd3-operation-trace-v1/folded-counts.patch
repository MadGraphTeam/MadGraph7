+        CALL MP_ML5_0_TERMINAL_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
+     $   ,OUT,WL_ENTRY_INEXACT)
+        RETURN
+      ENDIF
+C     STATIC_OWNER_FAST_PATH
+      SHARE_COUNTS(1,6)=SHARE_COUNTS(1,6)+1
+      OUT(:,:,:)=CMPLX(0.0E0_16,0.0E0_16,KIND=16)
+      DO J=1,OUT_SIZE
+        DO M=0,4
+          DO K=1,IN_SIZE
+            OP_COUNTS(7,6)=OP_COUNTS(7,6)+1
