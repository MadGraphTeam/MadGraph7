+        CALL MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      IF(ANY(TRANSFER(B(1,2,1),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(2,1
+     $ ,1),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,2)=SHARE_COUNTS(2,2)+1
+        CALL MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
