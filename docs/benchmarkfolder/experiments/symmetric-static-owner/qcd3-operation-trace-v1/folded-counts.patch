+      WL_ALREADY=WL_ENTRY_INEXACT
+      WL_HALT=.TRUE.
+      IF(IEEE_SUPPORT_HALTING(IEEE_INEXACT)) CALL
+     $  IEEE_GET_HALTING_MODE(IEEE_INEXACT,WL_HALT)
+      IF(.NOT.WL_NEAREST.OR..NOT.WL_ALREADY.OR.WL_HALT.OR.LCUT_SIZE.GT.
+     $OUT_SIZE.OR.MAXLWFSIZE.GT.16.OR.15.GT.65536.OR.5.GT.65536) THEN
+        SHARE_COUNTS(2,6)=SHARE_COUNTS(2,6)+1
+        CALL MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      WL_AZERO(1:IN_SIZE,0:14,1:LCUT_SIZE)=.FALSE.
+      IF(WL_NEAREST) THEN
+        DO WL_K=1,IN_SIZE
+          DO WL_I=1,LCUT_SIZE
+            DO WL_L=0,14
+              WL_AZERO(WL_K,WL_L,WL_I)=A(WL_K,WL_L,WL_I).EQ.0
+            ENDDO
+          ENDDO
+        ENDDO
+      ENDIF
+
+      IF(IN_SIZE.NE.4.OR.OUT_SIZE.NE.4.OR.MAXLWFSIZE.NE.4) THEN
+        SHARE_COUNTS(2,6)=SHARE_COUNTS(2,6)+1
+        CALL MP_ML5_0_TERMINAL_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
+     $   ,OUT,WL_ENTRY_INEXACT)
+        RETURN
+      ENDIF
+      IF(ANY(TRANSFER(B(3,1,4),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(3,4
+     $ ,4),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,6)=SHARE_COUNTS(2,6)+1
+        CALL MP_ML5_0_TERMINAL_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
+     $   ,OUT,WL_ENTRY_INEXACT)
+        RETURN
+      ENDIF
+      IF(ANY(TRANSFER(B(2,1,1),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(2,4
+     $ ,1),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,6)=SHARE_COUNTS(2,6)+1
+        CALL MP_ML5_0_TERMINAL_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
+     $   ,OUT,WL_ENTRY_INEXACT)
+        RETURN
+      ENDIF
+      IF(ANY(TRANSFER(B(2,1,2),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(2,4
+     $ ,2),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,6)=SHARE_COUNTS(2,6)+1
+        CALL MP_ML5_0_TERMINAL_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
+     $   ,OUT,WL_ENTRY_INEXACT)
+        RETURN
+      ENDIF
