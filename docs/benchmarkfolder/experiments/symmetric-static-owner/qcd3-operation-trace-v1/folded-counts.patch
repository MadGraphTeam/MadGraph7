+      IF(ANY(TRANSFER(B(4,1,4),(/0_8,0_8,0_8,0_8/)).NE.TRANSFER(B(4,4
+     $ ,4),(/0_8,0_8,0_8,0_8/)))) THEN
+        SHARE_COUNTS(2,7)=SHARE_COUNTS(2,7)+1
+        CALL MP_ML5_0_TERMINAL_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
