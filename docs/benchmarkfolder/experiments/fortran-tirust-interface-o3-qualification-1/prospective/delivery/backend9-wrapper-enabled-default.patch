--- a/Template/loop_material/StandAlone/SubProcesses/makefile
+++ b/Template/loop_material/StandAlone/SubProcesses/makefile
@@ -20,6 +20,10 @@
 # to turn off the bounds check. These can however be modified here if really necessary.
 POLYNOMIAL_OPTIMIZATION = -O3
 POLYNOMIAL_BOUNDS_CHECK =
+
+# Additional flags for the backend-9 Fortran wrapper only.
+# Override with make TIRUST_INTERFACE_FFLAGS='...' when required.
+TIRUST_INTERFACE_FFLAGS ?= -O3 -fno-fast-math
 
 include $(ROOT)/Source/make_opts
 FFLAGS += -I$(ROOT)/Source/MODEL -I$(ROOT)/Source/DHELAS
@@ -109,6 +113,13 @@
 		-c $< -o $@ $(LOOP_INCLUDE)
 
 
+# Keep wrapper flags out of prerequisites and all other backend sources.
+TIRUST_INTERFACE_OBJECTS = $(patsubst %.f,%.o,$(wildcard TIRUST_interface.f $(LOOP_PREFIX)*/TIRUST_interface.f))
+ifneq ($(strip $(TIRUST_INTERFACE_OBJECTS)),)
+$(TIRUST_INTERFACE_OBJECTS): %.o: %.f $(POLYNOMIAL) $(OLP_POLYNOMIAL)
+	$(FC) $(FFLAGS) $(TIRUST_INTERFACE_FFLAGS) -c $< -o $@ $(LOOP_INCLUDE)
+endif
+
 $(DOTO) : $(DOTF) $(POLYNOMIAL) $(OLP_POLYNOMIAL)
 	$(FC) $(FFLAGS) -c $< -o $@ $(LOOP_INCLUDE)
 
