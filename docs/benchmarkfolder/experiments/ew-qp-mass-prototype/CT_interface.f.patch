+
+      IF (CHECKPHASE.OR.(.NOT.HELDOUBLECHECKED)
+     $ .OR.GOODAMP(SQUAREDSOINDEX,LOOPNUM)) THEN
+        WE(1)=W1
+        WE(2)=W2
+        WE(3)=W3
+        WE(4)=W4
+      M2L(1)=M4**2
+      MP_M2L(1)=MP_M4**2
+      M2L(2)=M1**2
+      MP_M2L(2)=MP_M1**2
+      M2L(3)=M2**2
+      MP_M2L(3)=MP_M2**2
+      M2L(4)=M3**2
+      MP_M2L(4)=MP_M3**2
+        DO I=1,NLOOPLINE
