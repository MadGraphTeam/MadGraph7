+      SUBROUTINE ML5_0_LOOP_4_QPMASS(W1,W2,W3,W4,M1,MP_M1,M2,MP_M2,M3,
+     $ MP_M3,M4,MP_M4,RANK,SQUAREDSOINDEX,LOOPNUM)
