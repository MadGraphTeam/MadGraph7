+      COMPLEX*32 MP_M1,MP_M2,MP_M3,MP_M4
+
+      INTEGER RANK, LSYMFACT
+      INTEGER LOOPNUM, SQUAREDSOINDEX
+C     
+C     LOCAL VARIABLES 
+C     
