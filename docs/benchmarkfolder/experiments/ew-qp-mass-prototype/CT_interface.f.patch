+      INTEGER    NEXTERNAL
+      PARAMETER (NEXTERNAL=5)
+      INTEGER    NLOOPLINE
+      PARAMETER (NLOOPLINE=4)
+      INTEGER    NWAVEFUNCS
+      PARAMETER (NWAVEFUNCS=35)
