+      MODULE ML5_0_COLOR_CACHE
+      USE, INTRINSIC :: IEEE_ARITHMETIC
+      IMPLICIT NONE
+      INTEGER, PARAMETER :: CC_NROW=1275
+      INTEGER, PARAMETER :: CC_NAMP=8
+      INTEGER, PARAMETER :: CC_NSO=2
+      INTEGER, SAVE :: CC_MAP(CC_NROW)=0,CC_NCLASS=0
+      LOGICAL, SAVE :: CC_MAP_READY=.FALSE.
+      LOGICAL, SAVE :: CC_DP_ACTIVE=.FALSE.,CC_QP_ACTIVE=.FALSE.
+      LOGICAL, SAVE :: CC_DP_VALID(CC_NROW)=.FALSE.
+      LOGICAL, SAVE :: CC_QP_VALID(CC_NROW)=.FALSE.
+      COMPLEX*16, SAVE :: CC_DP(CC_NSO,CC_NROW)
+      COMPLEX*32, SAVE :: CC_QP(CC_NSO,CC_NROW)
+      CONTAINS
+      SUBROUTINE CC_PREPARE_MAP()
+      INTEGER CF_D(CC_NROW,CC_NAMP),CF_N(CC_NROW,CC_NAMP)
+      COMMON/ML5_0_CF/CF_D,CF_N
+      INTEGER I,J,REP(CC_NROW)
+      IF(CC_MAP_READY) RETURN
+      CC_NCLASS=0
+      DO I=1,CC_NROW
+        DO J=1,CC_NCLASS
+          IF(ALL(CF_N(I,:).EQ.CF_N(REP(J),:)).AND.
+     $       ALL(CF_D(I,:).EQ.CF_D(REP(J),:))) EXIT
+        ENDDO
+        IF(J.GT.CC_NCLASS) THEN
+          CC_NCLASS=J
+          REP(J)=I
+        ENDIF
+        CC_MAP(I)=J
+      ENDDO
+      CC_MAP_READY=.TRUE.
+      END SUBROUTINE
+      END MODULE
+
+      SUBROUTINE ML5_0_COLOR_CACHE_INVALIDATE()
+      USE ML5_0_COLOR_CACHE
+      CC_MAP_READY=.FALSE.
+      CC_DP_ACTIVE=.FALSE.
+      CC_QP_ACTIVE=.FALSE.
+      END
+
+      SUBROUTINE ML5_0_COLOR_CACHE_BEGIN_DP()
+      USE ML5_0_COLOR_CACHE
+      COMPLEX*16 AMP(CC_NAMP)
+      COMMON/ML5_0_AMPS/AMP
+      CALL CC_PREPARE_MAP()
+      CC_DP_VALID=.FALSE.
+      CC_DP_ACTIVE=ALL(IEEE_IS_FINITE(REAL(AMP,KIND=8)))
+     $  .AND.ALL(IEEE_IS_FINITE(AIMAG(AMP)))
+      END
+
+      SUBROUTINE ML5_0_COLOR_CACHE_END_DP()
+      USE ML5_0_COLOR_CACHE
+      CC_DP_ACTIVE=.FALSE.
+      END
+
+      SUBROUTINE ML5_0_COLOR_CACHE_BEGIN_QP()
+      USE ML5_0_COLOR_CACHE
+      COMPLEX*32 AMP(CC_NAMP)
+      COMMON/ML5_0_MP_AMPS/AMP
+      CALL CC_PREPARE_MAP()
+      CC_QP_VALID=.FALSE.
+      CC_QP_ACTIVE=ALL(IEEE_IS_FINITE(REAL(AMP,KIND=16)))
+     $  .AND.ALL(IEEE_IS_FINITE(AIMAG(AMP)))
+      END
+
+      SUBROUTINE ML5_0_COLOR_CACHE_END_QP()
+      USE ML5_0_COLOR_CACHE
+      CC_QP_ACTIVE=.FALSE.
+      END
