+#[derive(Default)]
+struct QpPrecision {
+    evaluations_256: u64,
+    eligible_refusals: u64,
+    evaluations_512: u64,
+    successes_512: u64,
+    failures_512: u64,
+    cache_256: u64,
+    cache_512: u64,
+    check_256: u64,
+    check_512: u64,
+    last_bits: u64,
+    last_condition_bits: u64,
+}
+impl QpPrecision {
+    fn statistics(&self) -> [u64; 11] {
+        [self.evaluations_256, self.eligible_refusals, self.evaluations_512,
+         self.successes_512, self.failures_512, self.cache_256, self.cache_512,
+         self.check_256, self.check_512, self.last_bits, self.last_condition_bits]
+    }
+}
+
+struct MpAttempt {
+    status: i32,
+    values: Vec<u8>,
+    eligible: bool,
+    message: String,
+    condition: Option<f64>,
+}
+impl MpAttempt {
+    fn success(values: Vec<u8>) -> Self {
+        Self { status: SUCCESS, values, eligible: false, message: String::new(), condition: None }
+    }
+    #[cfg(not(feature = "poles-only"))]
+    fn unsupported() -> Self {
+        Self { status: UNSUPPORTED, values: Vec::new(), eligible: false,
+               message: "pole-only build support is not installed".into(), condition: None }
+    }
+    fn failed(status: &LaneStatus, condition: Option<f64>, n: usize) -> Self {
+        Self { status: lane_status(status), values: Vec::new(),
+               eligible: gram_retry_eligible(status, condition, n),
+               message: format!("{status:?}"), condition }
+    }
+}
+
+fn gram_retry_eligible(status: &LaneStatus, condition: Option<f64>, n: usize) -> bool {
+    let LaneStatus::Unstable(message) = status else { return false; };
+    if !(1..=6).contains(&n) || !condition.is_some_and(|x| x.is_finite() && x > 0.0) {
+        return false;
+    }
+    let Some(rest) = message.strip_prefix("ill-conditioned Gram matrix for [") else { return false; };
+    let Some((members, printed)) = rest.split_once("]: conditioning ") else { return false; };
+    if !printed.parse::<f64>().is_ok_and(|x| x.is_finite() && x > 0.0) {
+        return false;
+    }
+    let members: std::result::Result<Vec<_>, _> = members.split(", ").map(str::parse::<usize>).collect();
+    let Ok(members) = members else { return false; };
+    members.len() >= 2 && members.len() <= n && members.iter().all(|&i| i < n)
+        && members.windows(2).all(|w| w[0] < w[1])
+}
+
+fn promote_batch(mut batch: KinematicsBatch<Float>, bits: u32) -> KinematicsBatch<Float> {
+    for value in &mut batch.values {
+        // These values were parsed at 113 bits and are already exact at 256.
+        // Increasing precision cannot manufacture additional input information.
+        value.re.set_prec(bits);
+        value.im.set_prec(bits);
+    }
+    batch
 }
 
