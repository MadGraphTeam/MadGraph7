+/// Private additive diagnostic query. Counts persist until context destruction;
+/// cache clears and budget changes do not erase actual precision work.
+/// Last bits describe the last dispatched QP request (zero on its failure),
+/// not an invalid foreign call rejected before reaching the dispatcher.
+/// # Safety
+/// `handle` is live and `out` has exactly eleven writable u64 entries.
+/// The last word is the f64 bit pattern of the last eligible powered condition,
+/// or zero if none; its only admitted reason category is the pinned Gram gate.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ml_tirust_qp_precision_statistics(
+    handle: *mut Context, out: *mut u64, count: usize,
+) -> i32 {
+    guard(|| {
+        length("QP precision statistics", count, 11)?;
+        validate_output(out)?;
+        let state = unsafe { context(handle)? }.state.lock()
+            .map_err(|_| "TIRust context poisoned")?;
+        unsafe { write(out, &state.qp_precision.statistics()); }
+        Ok(SUCCESS)
+    })
 
