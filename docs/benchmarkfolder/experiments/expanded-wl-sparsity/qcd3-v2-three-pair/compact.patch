       SUBROUTINE MP_ML5_0_UPDATE_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
      $ ,OUT)
       USE ML5_0_POLYNOMIAL_CONSTANTS
+      USE, INTRINSIC :: IEEE_ARITHMETIC
+      IMPLICIT NONE
+      INTEGER I,J,K,L,M
+      COMPLEX*32 A(MAXLWFSIZE,0:LOOPMAXCOEFS-1,MAXLWFSIZE)
+      COMPLEX*32 B(MAXLWFSIZE,0:VERTEXMAXCOEFS-1,MAXLWFSIZE)
+      COMPLEX*32 OUT(MAXLWFSIZE,0:LOOPMAXCOEFS-1,MAXLWFSIZE)
+      INTEGER LCUT_SIZE,IN_SIZE,OUT_SIZE
+      TYPE(IEEE_ROUND_TYPE) WL_ROUNDING
+      LOGICAL WL_NEAREST
+      LOGICAL WL_SKIP_ZERO
+      LOGICAL WL_AZERO(MAXLWFSIZE,0:LOOPMAXCOEFS-1,
+     $  MAXLWFSIZE)
+      INTEGER WL_I,WL_K,WL_L
+      INTEGER NEW_POSITION
+      COMPLEX*32 UPDATER_COEF
+
+C     Welcome to the computational heart of MadLoop...
+      CALL IEEE_GET_ROUNDING_MODE(WL_ROUNDING)
+      WL_NEAREST=WL_ROUNDING.EQ.IEEE_NEAREST
+      IF(.NOT.WL_NEAREST.OR.
+     $  .NOT.ALL(IEEE_IS_FINITE(REAL(A(1:IN_SIZE,0:14,
+     $    1:LCUT_SIZE),KIND=16))).OR.
+     $  .NOT.ALL(IEEE_IS_FINITE(AIMAG(A(1:IN_SIZE,0:14,
+     $    1:LCUT_SIZE)))).OR.
+     $  .NOT.ALL(IEEE_IS_FINITE(REAL(B(1:OUT_SIZE,0:4,
+     $    1:IN_SIZE),KIND=16))).OR.
+     $  .NOT.ALL(IEEE_IS_FINITE(AIMAG(B(1:OUT_SIZE,0:4,
+     $    1:IN_SIZE))))) THEN
+        CALL MP_ML5_0_UPDATE_WL_2_1_DENSE(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE,OUT)
+        RETURN
+      ENDIF
+      WL_AZERO(1:IN_SIZE,0:14,1:LCUT_SIZE)=.FALSE.
+      IF(WL_NEAREST) THEN
+        DO WL_K=1,IN_SIZE
+          DO WL_I=1,LCUT_SIZE
+            DO WL_L=0,14
+              IF(IEEE_IS_FINITE(REAL(A(WL_K,WL_L,WL_I),KIND=16))
+     $          .AND.IEEE_IS_FINITE(AIMAG(A(WL_K,WL_L,WL_I))))
+     $          WL_AZERO(WL_K,WL_L,WL_I)=A(WL_K,WL_L,WL_I).EQ.0
+            ENDDO
+          ENDDO
+        ENDDO
+      ENDIF
+      OUT(:,:,:)=CMPLX(0.0E0_16,0.0E0_16,KIND=16)
+      DO J=1,OUT_SIZE
+        DO M=0,4
+          DO K=1,IN_SIZE
+            UPDATER_COEF = B(J,M,K)
+            IF (UPDATER_COEF.EQ.CMPLX(0.0E0_16,0.0E0_16,KIND=16)) CYCLE
+            WL_SKIP_ZERO=.FALSE.
+            IF(WL_NEAREST) WL_SKIP_ZERO=
+     $        IEEE_IS_FINITE(REAL(UPDATER_COEF,KIND=16)).AND.
+     $        IEEE_IS_FINITE(AIMAG(UPDATER_COEF))
+
+            DO I=1,LCUT_SIZE
+              DO L=0,14
+                IF(WL_SKIP_ZERO) THEN
+                  IF(WL_AZERO(K,L,I)) CYCLE
+                ENDIF
+                NEW_POSITION = COMB_COEF_POS(L,M)
+                OUT(J,NEW_POSITION,I)=OUT(J,NEW_POSITION,I) + A(K,L,I)
+     $           *UPDATER_COEF
+              ENDDO
+            ENDDO
+          ENDDO
+        ENDDO
+      ENDDO
+
+      END
+
+
