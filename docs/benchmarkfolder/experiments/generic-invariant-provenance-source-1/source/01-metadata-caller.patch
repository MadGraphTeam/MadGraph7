+def kind(block, formal, width):
+    expected='TYPE('+('MP_ALOHA' if width==128 else 'ALOHA')+')'+formal
+    require(any(s==expected for _,s,_ in block['statements']),
+            'unsupported/mixed momentum storage '+formal)
