+            'IF(DOING_QP)THEN','MP_PL(I,J)=0.0E+0_16','ENDIF',
+            'DOK=TEMP,(TEMP+PAIRING(J)-1)','PL(I,J)=PL(I,J)-W(WE(K))%P(I)',
+            'IF(DOING_QP)THEN','MP_PL(I,J)=MP_PL(I,J)-MP_W(WE(K))%P(I)',
