+     $     ,OUT,WL_ENTRY_INEXACT)
+          RETURN
+        ENDIF
+      ENDDO
+      DO K=1,4
+        IF(B(3,3,K).NE.CMPLX(AIMAG(B(4,1,K)),-REAL(B(4,1,K),KIND=16)
+     $   ,KIND=16)) THEN
+          CALL MP_ML5_0_TERMINAL_WL_2_1(A,LCUT_SIZE,B,IN_SIZE,OUT_SIZE
+     $     ,OUT,WL_ENTRY_INEXACT)
+          RETURN
+        ENDIF
+      ENDDO
+      DO K=1,4
