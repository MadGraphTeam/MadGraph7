+def widen_binary64(data):
+    """Exact IEEE64→IEEE128 bits, including signed zero; no float conversion."""
+    require(len(data)%8==0,'binary64 widening alignment')
+    result=bytearray()
+    for start in range(0,len(data),8):
+        bits=int.from_bytes(data[start:start+8],'little')
+        sign=bits>>63; exponent=(bits>>52)&2047; fraction=bits&((1<<52)-1)
+        require(exponent!=2047,'nonfinite binary64 widening input')
+        if exponent:
+            wide=(sign<<127)|((exponent-1023+16383)<<112)|(fraction<<60)
+        elif fraction:
+            leading=fraction.bit_length()-1
+            wide=(sign<<127)|((leading-1074+16383)<<112)|((fraction-(1<<leading))<<(112-leading))
+        else:
+            wide=sign<<127
+        result.extend(wide.to_bytes(16,'little'))
+    return bytes(result)
 
