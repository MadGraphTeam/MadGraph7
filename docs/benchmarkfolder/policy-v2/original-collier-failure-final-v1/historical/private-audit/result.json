          "text": "          DIFF=MAXVAL(LIST,1,MASK)-MINVAL(LIST,1,MASK)"
        },
        {
          "line": 1938,
          "text": "          AVG=(MAXVAL(LIST,1,MASK)+MINVAL(LIST,1,MASK))/2.0D0"
        },
        {
          "line": 1939,
          "text": "          ESTIMATE(I,K)=AVG"
        },
        {
          "line": 1940,
          "text": "          IF (AVG.EQ.0.0D0) THEN"
        },
        {
          "line": 1941,
          "text": "            ACCURACIES(I)=DIFF"
        },
        {
          "line": 1942,
          "text": "          ELSE"
        },
        {
          "line": 1943,
          "text": "            ACCURACIES(I)=DIFF/ABS(AVG)"
        },
        {
          "line": 1944,
          "text": "          ENDIF"
        },
        {
          "line": 1945,
          "text": "        ENDDO"
        },
        {
          "line": 1946,
          "text": ""
        },
        {
          "line": 1947,
          "text": "C       The technique below is too sensitive, typically to"
        },
        {
          "line": 1948,
          "text": "C       unstablities in very small poles"
        },
        {
          "line": 1949,
          "text": "C       acc(k)=MAXVAL(ACCURACIES,1,MASK3)"
        },
        {
          "line": 1950,
          "text": "C       The following is used instead"
        },
        {
          "line": 1951,
          "text": "        ACC(K) = 0.0D0"
        },
        {
          "line": 1952,
          "text": "        AVG = 0.0D0"
        },
        {
          "line": 1953,
          "text": "        DO I=1,3"
        },
        {
          "line": 1954,
          "text": "          ACC(K) = ACC(K) + ACCURACIES(I)*ABS(ESTIMATE(I,K))"
        },
        {
          "line": 1955,
          "text": "          AVG = AVG + ESTIMATE(I,K)"
        },
        {
          "line": 1956,
          "text": "        ENDDO"
        },
        {
          "line": 1957,
          "text": "        IF (AVG.NE.0.0D0) THEN"
        },
        {
          "line": 1958,
          "text": "          ACC(K)  = ACC(K) / ( ABS(AVG) / 3.0D0)"
        },
        {
          "line": 1959,
          "text": "        ENDIF"
        },
        {
          "line": 1960,
          "text": ""
        },
        {
          "line": 1961,
          "text": "C       When using COLLIER with the internal stability test, the first"
        },
        {
          "line": 1962,
          "text": "C        evaluation is typically more reliable so we do not want to"
        },
        {
          "line": 1963,
          "text": "C        use the average but rather the first evaluation."
        },
        {
          "line": 1964,
          "text": "        IF (MLREDUCTIONLIB(I_LIB)"
        },
        {
          "line": 1965,
          "text": "     $   .EQ.7.AND.COLLIERUSEINTERNALSTABILITYTEST) THEN"
        },
        {
          "line": 1966,
          "text": "          DO I=1,3"
        },
        {
          "line": 1967,
          "text": "            ESTIMATE(I,K) = FULLLIST(I,K,1)"
        },
        {
          "line": 1968,
          "text": "          ENDDO"
        },
        {
          "line": 1969,
          "text": "        ENDIF"
        }
      ]
    },
