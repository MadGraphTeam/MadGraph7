+def process_prerequisites(directory, compiled):
+    """Inspect the canonical make prerequisites without invoking GNU make.
+
+    Only the literal PROCESS object names and its frozen patsubst/wildcard
+    idiom are supported. A changed make expression fails rather than causing
+    an implicit numerical rebuild or an unreviewed expression evaluation.
+    """
+    directory = Path(directory)
+    definitions = (directory.parent / 'MadLoop_makefile_definitions').read_text()
+    require(re.search(r'^\s*DOTO\s*=\s*%\.o\s*$', definitions, re.M)
+            and re.search(r'^\s*DOTF\s*=\s*%\.f\s*$', definitions, re.M),
+            'Unsupported canonical make object/source suffixes')
+    text = (directory / 'makefile').read_text().replace('\\\n', ' ')
+    assignments = re.findall(r'^PROCESS\s*=([^\n]*)$', text, re.M)
+    require(len(assignments) == 1, 'Exactly one canonical PROCESS assignment required')
+    wildcard = re.compile(r'\$\(patsubst\s+\$\(DOTF\),\$\(DOTO\),\$\(wildcard\s+([^()]+)\)\)')
+    def expand(match):
+        patterns = match.group(1).split()
+        require(patterns and all(re.fullmatch(r'[A-Za-z0-9_*?.]+\.f', pattern) for pattern in patterns),
+                'Unsupported canonical PROCESS wildcard')
+        return ' '.join(path.with_suffix('.o').name for pattern in patterns
+                        for path in sorted(directory.glob(pattern)) if path.is_file())
+    names = wildcard.sub(expand, assignments[0]).split()
+    require(names and len(names) == len(set(names))
+            and all(re.fullmatch(r'[A-Za-z0-9_]+\.o', name) for name in names),
+            'Unsupported or duplicate PROCESS object expression')
+    objects = {}
+    for name in names:
+        path = directory / name
+        require(path.is_file(), 'Missing frozen numerical object: ' + name)
+        objects[name] = {'sha256': digest(path), 'resolved': str(path.resolve())}
+    require(compiled['link_inputs_before'] == compiled['link_inputs_after'], 'Original link input bindings differ')
+    for records in compiled['link_inputs_before'].values():
+        for name, checksum in records.items():
+            require(Path(name).is_file() and digest(name) == checksum, 'Missing or changed original link input: ' + name)
+    includes = {}
+    for name in ('coupl.inc', 'MadLoopParams.inc', 'loop_max_coefs.inc', 'nsqso_born.inc'):
+        path = directory / name
+        require(path.is_file(), 'Missing private driver include prerequisite: ' + name)
+        includes[name] = {'sha256': digest(path), 'resolved': str(path.resolve())}
+    export = directory.parents[1]
+    settings = compiled['settings']
+    require({'Source/make_opts', 'SubProcesses/MadLoop_makefile_definitions'}.issubset(settings),
+            'Original build settings do not bind the make include files')
+    for name, expected in settings.items():
+        require((export / name).read_text() == expected, 'Frozen make include text differs: ' + name)
+    return {'numerical_objects': objects, 'driver_includes': includes,
+            'original_link_inputs': compiled['link_inputs_before'],
+            'makefile_sha256': digest(directory / 'makefile'),
+            'make_include_sha256': {name: digest(export / name) for name in settings},
+            'scope': 'current read-only prerequisite freeze; original numerical object bytes were not recorded separately'}
+
