+def readonly_preflight(value, helpers):
+    """Exercise every donor admission path without creating any work namespace.
+
+    Parent orchestration pins and loads this source and the read-only links
+    helper before calling. No CLI, compiler, loader, point generator, native
+    worker, or file-writing helper is invoked. Per-case failures are retained
+    in the returned structure so all four closed donors can be examined.
+    """
+    require(not WORK.exists() and not WORK.is_symlink(), 'Preflight requires a fresh, absent work namespace')
+    manifest, spec = verify_production(value)
+    links = helpers['links']
+    identity = manifest['candidate']['exporter_identity']
+    rows = []; guards = []
+    for case in CASE_IDS:
+        row = {'case': case, 'status': 'failed'}
+        try:
+            data = donor(value, spec, case, identity)
+            export = Path(data['export']); directory = export / data['subprocess']
+            snapshot = links.tree_snapshot(export)
+            audit = link_audit(links, snapshot)
+            links._guard_writes(export, snapshot)
+            inventories, leaves, observations, transitive = links._external_parts(audit)
+            files, directories, nodes = links._allowed_graph(inventories + [snapshot], leaves, observations, transitive)
+            links._admit_links(inventories + [snapshot], files, directories, nodes)
+            guards.append((export, snapshot, audit))
+            layout = group_layout(directory, data['compiled']['worker_render_parameters']['prefix'])
+            template = (HERE / 'stability_worker.f').read_text()
+            rendered = render(template, data['compiled']['worker_render_parameters'])
+            compiler = data['compiled']['effective_compiler_flags']['scopes']['process']['recipes']['check_sa.f']['compiler']
+            require(len(compiler) == 1 and Path(compiler[0]['path']).is_file()
+                    and digest(compiler[0]['path']) == compiler[0]['sha256'], 'Recorded compiler bytes differ')
+            shell = shutil.which('bash', path=environment(directory)['PATH'])
+            require(shell is not None and os.access(shell, os.X_OK), 'Environment Bash is missing or not executable')
+            loader = elf_interpreter(directory / 'check')
+            runtime = {str(Path(path).resolve()): checksum for path, checksum in data['runtime']['libraries'].items()}
+            require(runtime.get(str(loader)) == digest(loader), 'Actual donor PT_INTERP is not in its bound runtime')
+            prerequisites = process_prerequisites(directory, data['compiled'])
+            row.update(status='passed', generation_binding=data['generation_binding'],
+                build_receipts={name: digest(export / name) for name in ('generation.json', 'compilation.json')},
+                source_snapshot={'entry_count': snapshot['entry_count'],
+                                 'canonical_entries_sha256': snapshot['canonical_entries_sha256']},
+                external_graph=links.verify_external_graph(audit), group_layout=layout,
+                worker_template_sha256=digest(HERE / 'stability_worker.f'),
+                rendered_worker_sha256=hashlib.sha256(rendered.encode()).hexdigest(),
+                planned_make_addendum_sha256=hashlib.sha256(MAKEFILE.encode()).hexdigest(),
+                compiler=compiler[0], shell={'path': str(Path(shell).resolve()), 'sha256': digest(shell)},
+                target_interpreter={'path': str(loader), 'sha256': digest(loader), 'executed': False},
+                prerequisites=prerequisites)
+        except Exception as error:
+            row['error'] = {'class': type(error).__name__, 'message': str(error)}
+        rows.append(row)
+    for export, snapshot, audit in guards:
+        links.verify_tree(export, snapshot)
+        links.verify_external_graph(audit)
+    verify_production(value)
+    require(not WORK.exists() and not WORK.is_symlink(), 'Read-only preflight created a work namespace')
+    return {'schema': 'madloop-appendix-c-readonly-donor-preflight-v1',
+        'status': 'passed' if all(row['status'] == 'passed' for row in rows) else 'failed',
+        'production_source_revision': REVISION, 'generation_receipt_revision': GENERATION_REVISION,
+        'manifest_sha256': MANIFEST_SHA, 'exporter_files_sha256': GENERATOR_SHA,
+        'case_count': len(rows), 'cases': rows, 'commands_executed': 0,
+        'compiler_invocations': 0, 'loader_invocations': 0, 'amplitude_evaluations': 0,
+        'point_generation_calls': 0, 'work_namespace_written': False,
+        'read_only_inputs_unchanged_after_all_cases': True}
+
