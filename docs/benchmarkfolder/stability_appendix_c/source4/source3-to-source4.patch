+                                 ['Cards/MadLoopParams.dat', 'SubProcesses/P0/MadLoopParams.dat'])
+                pilot.private_changes(links, output, context, [output / name for name in record['card_write_intent']])
+
+    def test_intent_never_allows_unrelated_or_external_mutations(self):
+        for mutation in ('unrelated', 'new-file', 'external', 'link'):
+            with self.subTest(mutation=mutation), tempfile.TemporaryDirectory() as tmp:
+                links, output, context, external = self.fixture(Path(tmp))
+                intent = pilot.card_write_intent(links, output)
+                (output / intent[0]).write_text('intended card write\n')
+                if mutation == 'unrelated': (output / 'unrelated').write_text('changed\n')
+                elif mutation == 'new-file': (output / 'new-file').write_text('new\n')
+                elif mutation == 'external': external.write_text('changed external\n')
+                else:
+                    (output / 'SubProcesses/P0/MadLoopParams.dat').unlink()
+                    (output / 'SubProcesses/P0/MadLoopParams.dat').symlink_to(external)
+                with self.assertRaises(ValueError):
+                    pilot.private_changes(links, output, context, [output / name for name in intent])
+
+    def test_intent_rejects_external_card_destination_before_any_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            links, output, unused, external = self.fixture(Path(tmp))
+            (output / 'Cards/MadLoopParams.dat').unlink()
+            (output / 'Cards/MadLoopParams.dat').symlink_to(external)
+            before = external.read_bytes()
+            with self.assertRaises(ValueError): pilot.card_write_intent(links, output)
+            self.assertEqual(before, external.read_bytes())
