+class InheritedPreparation(unittest.TestCase):
+    def test_changed_ancestor_pin_fails_before_any_admission(self):
+        value = pilot.protocol()
+        with (mock.patch.object(pilot, 'digest', return_value='changed'),
+              mock.patch.object(pilot, 'read', side_effect=AssertionError('unbound read')),
+              mock.patch.object(pilot, 'verify_production', side_effect=AssertionError('production'))):
+            with self.assertRaisesRegex(ValueError, 'Inherited checkpoint changed: source_index'):
+                pilot.inherited_preparation(value, {})
+
+    def fixture(self, root):
+        work = root / 'work'; report = work / 'evidence'
+        links = types.SimpleNamespace(_resolve=lambda path, missing: (path, None, []))
+        checkpoint = {'cases': {case: {'immutable_master': case} for case in pilot.CASE_IDS}}
+        admission = {'checkpoint': checkpoint, 'binding': {'ancestor_sha256': {'preparation': 'same'},
+                                                        'commands_executed': 0}}
+        return work, report, links, admission
+
+    def test_inherit_publishes_same_cases_and_reordered_unexecuted_schedule_without_children(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            work, report, links, admission = self.fixture(Path(tmp))
+            with (mock.patch.object(pilot, 'WORK', work), mock.patch.object(pilot, 'REPORT', report),
+                  mock.patch.object(pilot, 'verify_seal', return_value='source4'),
+                  mock.patch.object(pilot, 'inherited_preparation', return_value=admission) as preflight,
+                  mock.patch.object(pilot, 'command', side_effect=AssertionError('child')),
+                  mock.patch.object(pilot.subprocess, 'Popen', side_effect=AssertionError('native'))):
+                pilot.inherit(pilot.protocol(), {'links': links})
+            self.assertEqual(preflight.call_count, 2)
+            prepared = pilot.read(report / 'prepare-terminal.json')
+            self.assertEqual(prepared['cases'], admission['checkpoint']['cases'])
+            self.assertEqual(prepared['preparation_mode'], 'inherited-readonly')
+            self.assertEqual([row['id'] for row in prepared['requests']],
+                             [row['id'] for row in pilot.requests(pilot.protocol())])
+            self.assertTrue(all(row['state'] == 'unexecuted' for row in prepared['requests']))
+            terminal = pilot.read(report / 'inherit-terminal.json')
+            self.assertEqual(terminal['status'], 'passed')
+            self.assertEqual(terminal['preparation_sha256'], pilot.digest(report / 'prepare-terminal.json'))
+            self.assertEqual(terminal['compiler_invocations'], 0)
+            self.assertEqual(terminal['loader_invocations'], 0)
+
+    def test_initial_admission_failure_leaves_work_namespace_absent(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            work, report, links, unused = self.fixture(Path(tmp))
+            with (mock.patch.object(pilot, 'WORK', work), mock.patch.object(pilot, 'REPORT', report),
+                  mock.patch.object(pilot, 'verify_seal', return_value='source4'),
+                  mock.patch.object(pilot, 'inherited_preparation', side_effect=ValueError('changed ancestor'))):
+                with self.assertRaisesRegex(ValueError, 'changed ancestor'):
+                    pilot.inherit(pilot.protocol(), {'links': links})
+            self.assertFalse(work.exists())
+
+    def test_changed_ancestor_during_admission_retains_failure_without_prepared_checkpoint(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            work, report, links, admission = self.fixture(Path(tmp))
+            changed = dict(admission, binding={'changed': True})
+            with (mock.patch.object(pilot, 'WORK', work), mock.patch.object(pilot, 'REPORT', report),
+                  mock.patch.object(pilot, 'verify_seal', return_value='source4'),
+                  mock.patch.object(pilot, 'inherited_preparation', side_effect=[admission, changed])):
+                with self.assertRaisesRegex(ValueError, 'changed during admission'):
+                    pilot.inherit(pilot.protocol(), {'links': links})
+            self.assertFalse((report / 'prepare-terminal.json').exists())
+            self.assertEqual(pilot.read(report / 'inherit-terminal.json')['status'], 'failed')
