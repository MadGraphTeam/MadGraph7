+def verify_source_inventory(root, files):
+    """Admit only the two exact dangling links in the frozen source inventory.
+
+    Null digests describe these specific unmaterialized tracked symlinks.
+    Every other entry retains the original file-content digest semantics,
+    including valid symlinks to files.
+    """
+    require({name for name, checksum in files.items() if checksum is None}
+            == set(FROZEN_DANGLING_LINKS), 'Frozen null source names differ')
+    for name, checksum in files.items():
+        path = Path(root) / name
+        if checksum is not None:
+            require(digest(path) == checksum, 'Production source differs: ' + name)
+            continue
+        require(path.is_symlink() and os.readlink(path) == FROZEN_DANGLING_LINKS[name],
+                'Frozen dangling source link differs: ' + name)
+        try:
+            path.stat()
+        except FileNotFoundError:
+            pass
+        else:
+            require(False, 'Frozen dangling source target was materialized: ' + name)
+
