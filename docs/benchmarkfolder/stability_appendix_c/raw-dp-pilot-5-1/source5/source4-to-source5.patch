+    def test_missing_physical_card_fails_closed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            links, output, unused, case = self.fixture(Path(tmp)); (output / 'Cards/param_card.dat').unlink()
+            with self.source_pins(), self.assertRaises(FileNotFoundError):
+                pilot.physical_card(links, output, output / case['donor']['subprocess'], case)
+
+    def test_shared_prelaunch_rejects_inherited_diagnostic_and_changed_executable_or_points(self):
+        for name in ('stability-values.dat', 'stability-dimensions.dat', 'stability-groups.dat', 'stability-check', 'points'):
+            with self.subTest(name=name), tempfile.TemporaryDirectory() as tmp:
