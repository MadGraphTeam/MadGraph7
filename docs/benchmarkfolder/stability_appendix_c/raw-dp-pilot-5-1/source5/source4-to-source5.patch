+class PrelaunchChecks(unittest.TestCase):
+    LHA = b'compiled reader fixture: direct, then Cards with zero through five parents\n'
+    RW = b'compiled SETPARA fixture calling LHA_loadcard\n'
+
+    def fixture(self, root):
+        links = CardFailureGuards.links(); master = root / 'master'; output = root / 'worker'
+        (master / 'Cards').mkdir(parents=True)
+        (master / 'Source/MODEL').mkdir(parents=True)
+        directory = master / 'SubProcesses/P0'
+        directory.mkdir(parents=True)
+        (master / 'Source/MODEL/lha_read.f').write_bytes(self.LHA)
+        (master / 'Source/MODEL/rw_para.f').write_bytes(self.RW)
+        (master / 'Cards/MadLoopParams.dat').write_text('original numerical card\n')
+        (master / 'Cards/param_card.dat').write_text('frozen physical card\n')
+        (directory / 'check_sa.f').write_text("      CALL SETPARA('param_card.dat')\n")
+        (directory / 'stability-check').write_bytes(b'opaque executable fixture; never loaded\n')
+        points = root / 'points.dat'; points.write_text('frozen points\n')
+        points.with_suffix('.json').write_text('{"frozen":"metadata"}\n')
+        snapshot = links.tree_snapshot(master)
+        context = links.prepare_worker(master, output, snapshot, {'external_roots': {}, 'readonly_files': {}})
+        case = {'donor': {'subprocess': 'SubProcesses/P0', 'physical_card_sha256': pilot.digest(master / 'Cards/param_card.dat'),
+                         'points': str(points), 'points_sha256': pilot.digest(points),
+                         'point_metadata_sha256': pilot.digest(points.with_suffix('.json'))},
+                'donor_context': {'master': str(master), 'expected_master': snapshot},
+                'executable_sha256': pilot.digest(directory / 'stability-check'),
+                'driver_sha256': pilot.digest(directory / 'check_sa.f')}
+        return links, output, context, case
+
+    def source_pins(self):
+        return mock.patch.multiple(pilot, LHA_READ_SHA=hashlib.sha256(self.LHA).hexdigest(),
+                                   RW_PARA_SHA=hashlib.sha256(self.RW).hexdigest())
+
+    @staticmethod
+    def banner():
+        module = types.ModuleType('madgraph.various.banner')
+        class Card(dict):
+            def __init__(self, path): super().__init__(pilot.card_settings(9))
+            def write(self, path, **kwargs):
+                lines = []
+                for key, value in self.items():
+                    token = ('.TRUE.' if value else '.FALSE.') if isinstance(value, bool) else str(value)
+                    lines.extend(('#' + key, token))
+                Path(path).write_text('\n'.join(lines + ['/* End of param file */', '']))
+        module.MadLoopParam = Card
+        return module
+
+    def test_shared_prelaunch_and_postguard_complete_without_native_calls(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            links, output, context, case = self.fixture(Path(tmp)); record = {}
+            original_path = list(sys.path)
+            try:
+                with (self.source_pins(), mock.patch.dict(sys.modules, {'madgraph.various.banner': self.banner()}),
+                      mock.patch.object(pilot, 'verify_production', return_value=None),
+                      mock.patch.object(pilot.subprocess, 'Popen', side_effect=AssertionError('native')),
+                      mock.patch.object(pilot, 'command', side_effect=AssertionError('command'))):
+                    directory = pilot.prelaunch_worker({}, {'backend': 9}, case, output, {'links': links}, record)
+                    guard = pilot.worker_postguard({}, case, output, context, {'links': links}, record)
+            finally:
+                sys.path[:] = original_path
+            self.assertEqual(directory, output / 'SubProcesses/P0')
+            self.assertEqual(record['physical_card']['first_existing_index'], 3)
+            self.assertEqual(record['physical_card']['first_existing_name'], '../.././Cards/param_card.dat')
+            self.assertEqual([item['exists'] for item in record['physical_card']['attempts']], [False, False, False, True])
+            self.assertEqual(record['prelaunch']['status'], 'passed')
+            self.assertTrue(guard['source_and_external_guards_passed'])
+            self.assertEqual(record['effective_card']['settings'], pilot.card_settings(9))
+
+    def test_direct_match_precedes_cards_fallback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            links, output, unused, case = self.fixture(Path(tmp)); directory = output / case['donor']['subprocess']
+            (directory / 'param_card.dat').write_bytes((output / 'Cards/param_card.dat').read_bytes())
+            with self.source_pins(): result = pilot.physical_card(links, output, directory, case)
+            self.assertEqual(result['first_existing_index'], 0)
+            self.assertEqual(len(result['attempts']), 1)
+
+    def test_first_existing_wrong_hash_external_or_directory_is_never_skipped(self):
+        for kind in ('wrong-hash', 'external', 'directory'):
+            with self.subTest(kind=kind), tempfile.TemporaryDirectory() as tmp:
+                root = Path(tmp); links, output, unused, case = self.fixture(root)
+                directory = output / case['donor']['subprocess']; shadow = directory / 'param_card.dat'
+                if kind == 'wrong-hash': shadow.write_text('wrong physical card\n')
+                elif kind == 'directory': shadow.mkdir()
+                else:
+                    external = root / 'external'; external.write_bytes((output / 'Cards/param_card.dat').read_bytes())
+                    shadow.symlink_to(external)
+                with self.source_pins(), self.assertRaises(ValueError):
+                    pilot.physical_card(links, output, directory, case)
+
+    def test_changed_source_chain_or_driver_cannot_admit_card(self):
+        for name in ('Source/MODEL/lha_read.f', 'Source/MODEL/rw_para.f', 'SubProcesses/P0/check_sa.f'):
+            with self.subTest(name=name), tempfile.TemporaryDirectory() as tmp:
+                links, output, unused, case = self.fixture(Path(tmp)); (output / name).write_text('changed source\n')
+                with self.source_pins(), self.assertRaises(ValueError):
+                    pilot.physical_card(links, output, output / case['donor']['subprocess'], case)
