+def physical_card(links, output, directory, case):
+    """Resolve SETPARA's first existing card using the pinned compiled reader.
+
+    LHA_open_file first opens the literal filename, then tries ./Cards/filename
+    followed by five parent prefixes. A shadowing match is never skipped.
+    """
+    output = Path(output); directory = Path(directory)
+    source = output / 'Source/MODEL/lha_read.f'
+    source_blob = source.read_bytes()
+    require(hashlib.sha256(source_blob).hexdigest() == LHA_READ_SHA,
+            'Compiled LHA card-search source differs')
+    wrapper = output / 'Source/MODEL/rw_para.f'; wrapper_blob = wrapper.read_bytes()
+    require(hashlib.sha256(wrapper_blob).hexdigest() == RW_PARA_SHA,
+            'Compiled SETPARA card-reader source differs')
+    driver = directory / 'check_sa.f'; driver_blob = driver.read_bytes()
+    require(hashlib.sha256(driver_blob).hexdigest() == case['driver_sha256']
+            and driver_blob.count(b"CALL SETPARA('param_card.dat')") == 1,
+            'Compiled driver card-search entrypoint differs')
+    candidates = ['param_card.dat'] + ['../' * level + './Cards/param_card.dat' for level in range(6)]
+    attempts = []
+    for index, name in enumerate(candidates):
+        candidate = directory / name
+        exists = candidate.exists(); attempts.append({'name': name, 'exists': exists})
+        if not exists: continue
+        require(candidate.is_file(), 'First physical-card match is not a regular file')
+        resolved = links.assert_private_path(output, candidate)
+        checksum = digest(candidate)
+        require(checksum == case['donor']['physical_card_sha256'],
+                'Driver-resolved physical card differs or is shadowed')
+        return {'search_source': str(source), 'search_source_sha256': LHA_READ_SHA,
+                'setpara_source': str(wrapper), 'setpara_source_sha256': RW_PARA_SHA,
+                'driver_sha256': case['driver_sha256'], 'search_order': candidates,
+                'attempts': attempts,
+                'first_existing_index': index, 'first_existing_name': name,
+                'path': str(candidate), 'resolved_private_path': str(resolved), 'sha256': checksum}
+    raise FileNotFoundError('Compiled LHA card search found no physical card in its seven candidates')
+
+
+def prelaunch_worker(value, request, case, output, helpers, record):
+    """Shared run/dry-proof preparation up to the lock/native boundary."""
+    links = helpers['links']; output = Path(output)
+    directory = output / case['donor']['subprocess']
+    record['card_write_intent'] = card_write_intent(links, output)
+    record['effective_card'] = configure_card(links, output, request['backend'], record['card_write_intent'])
+    record['physical_card'] = physical_card(links, output, directory, case)
+    diagnostic_names = ('stability-values.dat', 'stability-dimensions.dat', 'stability-groups.dat')
+    for name in diagnostic_names:
+        path = directory / name
+        links.assert_private_path(output, path)
+        require(not path.exists() and not path.is_symlink(), 'Inherited diagnostic output would pollute worker')
+    require(digest(directory / 'stability-check') == case['executable_sha256'], 'Private executable changed')
+    metadata = Path(case['donor']['points']).with_suffix('.json')
+    require(digest(case['donor']['points']) == case['donor']['points_sha256']
+            and digest(metadata) == case['donor']['point_metadata_sha256'],
+            'Fresh point stream changed after preparation')
+    record['prelaunch'] = {'status': 'passed', 'diagnostic_outputs_absent': list(diagnostic_names),
+                          'executable_sha256': case['executable_sha256'],
+                          'points_sha256': case['donor']['points_sha256'],
+                          'point_metadata_sha256': case['donor']['point_metadata_sha256'],
+                          'native_calls': 0}
+    return directory
+
