set automatic_html_opening False
set auto_update 0
set nb_core 4
set loop_optimized_output True
set output_dependencies external
set complex_mass_scheme False
set ninja /shared/external/madloop_ninjars/madgraph7_madloop_ninjars/.benchmark-work/original/HEPTools/ninja/lib
set collier /shared/external/madloop_ninjars/madgraph7_madloop_ninjars/.benchmark-work/original/HEPTools/collier
import model loop_sm
generate g g > h [sqrvirt=QCD]
output standalone /shared/external/madloop_ninjars/madgraph7_madloop_ninjars/.benchmark-work/outputs/baseline/control-gg-h
quit
