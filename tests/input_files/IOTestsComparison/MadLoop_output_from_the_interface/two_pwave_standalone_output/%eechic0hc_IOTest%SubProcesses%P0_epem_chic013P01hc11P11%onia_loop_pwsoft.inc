     $ ,0.00000000000000000D+00,0.00000000000000000D+00
     $ ,0.00000000000000000D+00,0.00000000000000000D+00/
C     X between the Born flows and those of the S-wave state, per link
      REAL*8 PWS_FX_RE(1,1,1,2), PWS_FX_IM(1,1,1,2)
      DATA PWS_FX_RE/0.00000000000000000D+00,0.00000000000000000D+00/
      DATA PWS_FX_IM/0.00000000000000000D+00,0.00000000000000000D+00/
