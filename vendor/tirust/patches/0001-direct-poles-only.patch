+fn pole_rotation_and_changed_scale_cache_are_independent() {
+    let mut settings = ReductionSettings::new(3, 4);
+    settings.convention = Convention::MadLoop;
+    let plan = DirectReductionPlan::new(settings).unwrap();
+    let mut batch = massive(3, &0.0);
+    let mut poles = plan.pole_workspace(0.).unwrap();
+    let (primary, check) = poles.reduce_batch_with_rotation(&batch, 1).unwrap();
+    let rotated = plan.rotated_batch(&batch, 1).unwrap();
+    assert_eq!(
+        primary.lane(0),
+        plan.pole_workspace(0.)
+            .unwrap()
+            .reduce_batch(&batch)
+            .unwrap()
+            .lane(0)
+    );
+    assert_eq!(
+        check.lane(0),
+        plan.pole_workspace(0.)
+            .unwrap()
+            .reduce_batch(&rotated)
+            .unwrap()
+            .lane(0)
+    );
+    let store = PoleTensorStore::new(Some(8 * 1024 * 1024));
+    poles.set_tensor_store(Some(&store));
+    for scale in [1., 17., 1.] {
+        batch.values.last_mut().unwrap().re = scale;
+        batch.values[1].re += 0.125;
+        let cached = poles.reduce_batch(&batch).unwrap();
+        let fresh = plan
+            .pole_workspace(0.)
+            .unwrap()
+            .reduce_batch(&batch)
+            .unwrap();
+        assert_eq!(cached.lane(0), fresh.lane(0));
+    }
+}
