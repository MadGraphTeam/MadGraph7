+//! Truncated Laurent execution: finite coefficients are neither evaluated nor exposed.
+use super::{DirectExecutor, DirectMasters, DirectProfile, DirectReductionPlan};
+use crate::basis::Monomial;
+use crate::{
+    BatchResult, KinematicsBatch, LaneStatus, ReductionError, ResultMetadata, TensorStore,
+    TensorStoreOptions, TensorStoreStatistics,
+};
+use iregi_masters::NativeFloat;
+use std::sync::Arc;
+use symbolica::{
+    domains::float::{Complex, FloatLike},
+    evaluate::EvaluationDomain,
+};
+
+/// Explicitly partial tensor result, with three coefficients per monomial:
+/// `[UV1, IR1, IR2]`. This type has no finite coefficient or full-result conversion.
+#[derive(Clone, Debug)]
+pub struct PoleBatchResult<T: FloatLike> {
+    pub basis: Vec<Monomial>,
+    pub statuses: Vec<LaneStatus>,
+    values: Vec<Complex<T>>,
+    metadata: ResultMetadata,
+}
+impl<T: FloatLike> PoleBatchResult<T> {
+    fn from_scratch(result: BatchResult<T>) -> Self {
+        debug_assert_eq!(result.components, 1);
+        let values = result
+            .values
+            .chunks_exact(4)
+            .flat_map(|v| v[..3].iter().cloned())
+            .collect();
+        Self {
+            basis: result.basis,
+            statuses: result.statuses,
+            values,
+            metadata: result.metadata,
+        }
+    }
+    pub fn rows(&self) -> usize {
+        self.statuses.len()
+    }
+    pub fn metadata(&self) -> &ResultMetadata {
+        &self.metadata
+    }
+    pub fn lane(&self, row: usize) -> Result<&[Complex<T>], &LaneStatus> {
+        if self.statuses[row] != LaneStatus::Success {
+            return Err(&self.statuses[row]);
+        }
+        let width = self.basis.len() * 3;
+        Ok(&self.values[row * width..(row + 1) * width])
+    }
+}
+
+/// A separate cache namespace: a pole store cannot be attached to a full workspace.
+/// No external full-master provider is accepted by this type.
+#[derive(Clone, Debug)]
+pub struct PoleTensorStore {
+    inner: TensorStore,
+}
+impl PoleTensorStore {
+    pub fn new(byte_budget: Option<u64>) -> Self {
+        Self {
+            inner: TensorStore::with_options(TensorStoreOptions {
+                byte_budget,
+                ..Default::default()
+            }),
+        }
+    }
+    pub fn register(&self, plan: &DirectReductionPlan) {
+        self.inner.register(plan);
+    }
+    pub fn clear(&self) {
+        self.inner.clear();
+    }
+    pub fn set_sharing(&self, enabled: bool) {
+        self.inner.set_sharing(enabled);
+    }
+    pub fn set_byte_budget(&self, bytes: Option<u64>) {
+        self.inner.set_byte_budget(bytes);
+    }
+    pub fn statistics(&self) -> TensorStoreStatistics {
+        self.inner.statistics()
+    }
+    pub fn check_view(&self) -> Self {
+        Self {
+            inner: self.inner.check_view(),
+        }
+    }
+}
+
+/// Ordinary D=4-2 epsilon tensor reduction whose arithmetic omits the finite slot.
+/// DD and small-Gram auxiliary executors carry the same compile-time mode.
+#[derive(Clone)]
+pub struct DirectPoleWorkspace<T: NativeFloat> {
+    executor: DirectExecutor<T, true>,
+}
+
+impl DirectReductionPlan {
+    pub fn pole_workspace<T: NativeFloat>(
+        &self,
+        prototype: T,
+    ) -> Result<DirectPoleWorkspace<T>, ReductionError>
+    where
+        Complex<T>: EvaluationDomain,
+    {
+        let s = self.settings();
+        if s.propagators > 6
+            || s.rank > 6
+            || s.dimension_shift != 0
+            || s.powers.iter().any(|&p| p != 1)
+        {
+            return Err(ReductionError::Unsupported("pole-only execution supports undotted D=4-2epsilon integrals with N<=6 and rank<=6".into()));
+        }
+        Ok(DirectPoleWorkspace {
+            executor: DirectExecutor::new(self.data.clone(), prototype, DirectMasters::Native)?,
+        })
+    }
+}
+
+impl<T: NativeFloat> DirectPoleWorkspace<T>
+where
+    Complex<T>: EvaluationDomain,
+{
+    pub fn reduce_batch(
+        &mut self,
+        batch: &KinematicsBatch<T>,
+    ) -> Result<PoleBatchResult<T>, ReductionError> {
+        self.executor
+            .reduce_batch(batch)
+            .map(PoleBatchResult::from_scratch)
+    }
+    pub fn set_tensor_store(&mut self, store: Option<&PoleTensorStore>) {
+        if let Some(store) = store {
+            store.register(&DirectReductionPlan {
+                data: self.executor.base_plan().clone(),
+            });
+        }
+        self.executor
+            .set_shared_subsets(store.map(|store| store.inner.shared().clone()));
+    }
+    pub fn set_profiling(&mut self, enabled: bool) {
+        self.executor.set_profiling(enabled);
+    }
+    pub fn last_profile(&self) -> DirectProfile {
+        self.executor.last_profile()
+    }
+    pub fn last_master_rows(&self) -> usize {
+        self.executor.last_master_rows()
+    }
+    pub fn enable_partial_rescue(&mut self, threshold: f64) {
+        self.executor.enable_partial_rescue(threshold);
+    }
+    pub fn disable_partial_rescue(&mut self) {
+        self.executor.disable_partial_rescue();
+    }
+    pub fn enable_gram_expansion(&mut self, boost: u16) {
+        self.executor.enable_gram_expansion(boost);
+    }
+    pub fn enable_estimated_method_choice(&mut self, boost: u16, threshold: T) {
+        self.executor
+            .enable_estimated_method_choice(boost, threshold);
+    }
+    pub fn enable_alternative_pv(&mut self) {
+        self.executor.enable_alternative_pv();
+    }
+    pub fn set_alternative_first(&mut self, limit: Option<f64>) {
+        self.executor.set_alternative_first(limit);
+    }
+    pub fn set_stability_threshold(&mut self, threshold: T) {
+        self.executor.set_stability_threshold(threshold);
+    }
+    pub fn set_input_precision(&mut self, bits: u32) {
+        self.executor.set_input_precision(bits);
+    }
+    pub fn last_conditions(&self) -> &[Option<f64>] {
+        self.executor.last_conditions()
+    }
+    pub fn last_gram_lanes(&self) -> &[bool] {
+        self.executor.last_gram_lanes()
+    }
+    /// An independent cyclic check, with the same pole-only arithmetic.
+    pub fn reduce_batch_with_rotation(
+        &mut self,
+        batch: &KinematicsBatch<T>,
+        rotation: usize,
+    ) -> Result<(PoleBatchResult<T>, PoleBatchResult<T>), ReductionError> {
+        let plan = DirectReductionPlan {
+            data: self.executor.base_plan().clone(),
+        };
+        let rotated = plan.rotated_batch(batch, rotation)?;
+        let private = self.executor.shared_subsets().is_none().then(|| {
+            let store = Arc::new(super::shared::SubsetStore::default());
+            store.set_enabled(true);
+            store.set_masters_only(!self.executor.injects_subsets());
+            for (size, rank) in plan.nested_gathers() {
+                store.share_moments(size, rank);
+            }
+            store
+        });
+        if let Some(store) = &private {
+            self.executor.set_shared_subsets(Some(store.clone()));
+        }
+        let outcome = (|| {
+            let primary = self.executor.reduce_batch(batch)?;
+            let first = self.executor.take_call();
+            let check = self.executor.reduce_check_batch(&rotated)?;
+            self.executor.merge_call(first);
+            Ok((
+                PoleBatchResult::from_scratch(primary),
+                PoleBatchResult::from_scratch(check),
+            ))
+        })();
+        if private.is_some() {
+            self.executor.set_shared_subsets(None);
+        }
+        outcome
+    }
+}
