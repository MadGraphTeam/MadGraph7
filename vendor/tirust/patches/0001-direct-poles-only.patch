+//! Qualified pole-only domain and agreement with the untruncated direct engine.
+mod common;
+use iregi_masters::NativeFloat;
+use iregi_rust::{
+    Convention, DirectReductionPlan, KinematicsBatch, PoleTensorStore, ReductionSettings,
+};
