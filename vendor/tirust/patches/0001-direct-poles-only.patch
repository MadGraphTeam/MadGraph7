+#[test]
+fn small_gram_pole_rescue_keeps_partial_execution() {
+    let lane = common::lanes(include_str!("fixtures/method_choice_lanes.json")).remove(0);
+    let plan = DirectReductionPlan::new(common::settings(&lane, true)).unwrap();
+    let batch = common::batch(&lane, true);
+    let mut poles = plan.pole_workspace(0.).unwrap();
+    poles.enable_gram_expansion(12);
+    let result = poles.reduce_batch(&batch).unwrap();
+    assert!(poles.last_gram_lanes()[0]);
+    let input = KinematicsBatch {
+        rows: 1,
+        components: 1,
+        values: batch
+            .values
+            .iter()
+            .map(|z| Complex::new(Float::with_val(192, z.re), Float::with_val(192, z.im)))
+            .collect(),
+    };
+    let mut high = plan.workspace(Float::new(192)).unwrap();
+    high.set_stability_threshold(Float::with_val(192, 2f64.powi(-150)));
+    let reference = high.reduce_batch(&input).unwrap();
+    let mut error = [0.0f64; 3];
+    let mut size = [0.0f64; 3];
+    for ((monomial, a), b) in result
+        .basis
+        .iter()
+        .zip(result.lane(0).unwrap().chunks_exact(3))
+        .zip(reference.lane(0).unwrap().chunks_exact(4))
+    {
+        let weight = lane
+            .mu2
+            .sqrt()
+            .powi(monomial.rank() as i32 + 4 - 2 * lane.n as i32);
+        for slot in 0..3 {
+            let b = Complex::new(b[slot].re.to_f64(), b[slot].im.to_f64());
+            error[slot] = error[slot].max((a[slot] - b).norm().re / weight);
+            size[slot] = size[slot].max(b.norm().re / weight);
+        }
+    }
+    for slot in 0..3 {
+        assert!(
+            error[slot] < 1e-8 * size[slot].max(1e-20),
+            "slot {slot}: {} / {}",
+            error[slot],
+            size[slot]
+        );
+    }
+}
